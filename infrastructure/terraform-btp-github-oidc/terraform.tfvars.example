# =============================================================================
# Example terraform.tfvars — copy to terraform.tfvars and fill in.
# =============================================================================
# Run this once:
#   cp terraform.tfvars.example terraform.tfvars
# Then edit values below. Never commit terraform.tfvars (it's gitignored).

# The BTP subaccount that hosts your application. Find via:
#   btp list accounts/subaccount --format json | jq '.value[] | {name, guid, subdomain}'
subaccount_id = "00000000-0000-0000-0000-000000000000"

# Your SAP Identity Authentication tenant FQDN. Usually visible in the URL of
# your IAS admin console (https://<this>/admin).
ias_tenant_host = "yourcompany.accounts.ondemand.com"

# The GitHub repo allowed to authenticate via this trust. Use "<owner>/<repo>".
github_repo = "sap-tutorials/tutorials-ims"

# Optional: short prefix for the BTP-side resource names. Becomes part of the
# origin key and role-collection names. Lowercase, kebab-case.
trust_name_prefix = "tutorials"

# Per-environment CI deployer role collections.
# Pick `role_template_app_id` + `role_template_name` from BTP cockpit:
#   Subaccount → Security → Role Collections → New → Add Role → see app+template
# The CF Space Developer app-id usually looks like "cf-<subaccount-guid>".
environments = {
  dev = {
    cf_space             = "dev"
    role_template_app_id = "cf-CHANGEME-CHANGEME-CHANGEME-CHANGEMECHANGE"
    role_template_name   = "Space Developer"
    role_name            = "Space Developer"

    # MTA Administrator is required for `cf deploy mtar`. Find its app-id
    # via `btp list security/roles` (typically `mta_!t<n>`).
    extra_role_assignments = [
      {
        name                 = "MtaDeployAdministrator"
        role_template_app_id = "mta_!t10" # ← verify in your subaccount
        role_template_name   = "MtaDeployAdministrator"
      },
    ]
  }

  qa = {
    cf_space             = "qa"
    role_template_app_id = "cf-CHANGEME-CHANGEME-CHANGEME-CHANGEMECHANGE"
    role_template_name   = "Space Developer"
    role_name            = "Space Developer"
    extra_role_assignments = [
      {
        name                 = "MtaDeployAdministrator"
        role_template_app_id = "mta_!t10"
        role_template_name   = "MtaDeployAdministrator"
      },
    ]
  }

  # Uncomment when ready for prod. GitHub Environment "prod" should require
  # reviewers (Settings → Environments → prod → Required reviewers).
  # prod = {
  #   cf_space             = "prod"
  #   role_template_app_id = "cf-CHANGEME-CHANGEME-CHANGEME-CHANGEMECHANGE"
  #   role_template_name   = "Space Developer"
  #   role_name            = "Space Developer"
  #   extra_role_assignments = [
  #     {
  #       name                 = "MtaDeployAdministrator"
  #       role_template_app_id = "mta_!t10"
  #       role_template_name   = "MtaDeployAdministrator"
  #     },
  #   ]
  # }
}
