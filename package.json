{
  "name": "tutorials-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch:hybrid": "cds watch --profile hybrid",
    "dev:hybrid": "npm run watch:hybrid & npm run start:approuter",
    "start:approuter": "cd approuter && npm start",
    "bind:setup": "node scripts/setup-hybrid-env.js",
    "build:cds": "cds build --production",
    "fetch-tutorials": "tsx scripts/fetch-tutorials.ts --target hugo",
    "fetch-tutorials:hugo": "tsx scripts/fetch-tutorials.ts --target hugo",
    "discover-repos": "tsx scripts/fetch-tutorials.ts --discover-only",
    "generate-dark-theme": "tsx scripts/generate-dark-theme.ts",
    "validate-tutorials": "tsx scripts/validate-tutorials.ts",
    "migrate:reference": "node scripts/migrate-reference-data.js",
    "migrate:users": "node scripts/migrate-user-progress.js",
    "migrate:hana": "node scripts/migrate-from-hana.js",
    "compare": "node scripts/compare-systems.js",
    "build:css": "postcss hugo/assets/css/sap-fundamental.css --config hugo/ --no-map -o hugo/static/css/sap-fundamental.css",
    "build:apps": "npm --prefix apps run build",
    "build:hugo": "hugo --source hugo --minify",
    "build:highlight": "tsx scripts/highlight-cds.ts",
    "build:display": "cd display-app && npm install && npm run build",
    "build:all": "npm run fetch-tutorials -- --regenerate && npm run build:css && npm run build:apps && npm run build:hugo && npm run build:highlight && npm run build:display",
    "build:admin": "npm --prefix app/admin run build && npm --prefix app/admin-custom run build",
    "dev": "hugo server --source hugo",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:hybrid": "cds bind --exec -- npx vitest run --project hybrid",
    "test:hybrid:watch": "cds bind --exec -- npx vitest --project hybrid",
    "test:smoke": "vitest run --project smoke",
    "test:all": "cds bind --exec -- npx vitest run"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.0",
    "@sap/cds-dk": "^9.9.0",
    "cds-plugin-ui5": "^0.17.0",
    "fundamental-styles": "^0.41.4",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.1",
    "postcss": "^8.5.12",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "sap.tutorials.admin.accomplishments": "file:app/admin/accomplishments",
    "sap.tutorials.admin.accounts": "file:app/admin/accounts",
    "sap.tutorials.admin.changelog": "file:app/admin/changelog",
    "sap.tutorials.admin.events": "file:app/admin/events",
    "sap.tutorials.admin.groups": "file:app/admin/groups",
    "sap.tutorials.admin.missions": "file:app/admin/missions",
    "sap.tutorials.admin.operations": "file:app/admin/operations",
    "sap.tutorials.admin.prizes": "file:app/admin/prizes",
    "sap.tutorials.admin.tags": "file:app/admin/tags",
    "sap.tutorials.admin.tutorials": "file:app/admin/tutorials",
    "shiki": "^4.0.2",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.7.0"
  },
  "dependencies": {
    "@cap-js-community/websocket": "^1.0.0",
    "@cap-js/audit-logging": "^1.2.0",
    "@cap-js/change-tracking": "^2.0.0-beta.11",
    "@cap-js/hana": "^2.7.1",
    "@cap-js/ord": "^1.6.0",
    "@cap-js/sqlite": "^2.2.1",
    "@cap-js/telemetry": "^1.6.0",
    "@grpc/grpc-js": "^1.14.3",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.57.2",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.2",
    "@sap/cds": "^9.9.0",
    "@sap/xsenv": "^5.6.1",
    "@sap/xssec": "^4.13.0",
    "hdb": "^0.19.12",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.0"
  },
  "cds": {
    "cds-plugin-ui5": {
      "modules": {
        "sap.tutorials.admin.events": {
          "mountPath": "/admin/events"
        },
        "sap.tutorials.admin.missions": {
          "mountPath": "/admin/missions"
        },
        "sap.tutorials.admin.groups": {
          "mountPath": "/admin/groups"
        },
        "sap.tutorials.admin.tutorials": {
          "mountPath": "/admin/tutorials"
        },
        "sap.tutorials.admin.tags": {
          "mountPath": "/admin/tags"
        },
        "sap.tutorials.admin.accomplishments": {
          "mountPath": "/admin/accomplishments"
        },
        "sap.tutorials.admin.prizes": {
          "mountPath": "/admin/prizes"
        },
        "sap.tutorials.admin.operations": {
          "mountPath": "/admin/operations"
        },
        "sap.tutorials.admin.accounts": {
          "mountPath": "/admin/accounts"
        },
        "sap.tutorials.admin.changelog": {
          "mountPath": "/admin/changelog"
        },
        "admin-custom": {
          "mountPath": "/admin-custom"
        }
      }
    },
    "requires": {
      "db": {
        "[hybrid]": {
          "kind": "hana"
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "audit-log": {
        "[hybrid]": {
          "kind": "audit-log-to-console"
        }
      },
      "ngds": {
        "kind": "rest",
        "[hybrid]": {
          "kind": "rest",
          "credentials": {
            "destination": "ngds-destination",
            "path": "/ngds/developers/ims"
          }
        },
        "[production]": {
          "kind": "rest",
          "credentials": {
            "destination": "ngds-destination",
            "path": "/ngds/developers/ims"
          }
        }
      },
      "telemetry": {
        "kind": "telemetry-to-console",
        "tracing": {
          "sampler": {
            "kind": "ParentBasedSampler",
            "root": "AlwaysOnSampler",
            "ignoreIncomingPaths": [
              "/health",
              "/health/db"
            ]
          }
        },
        "[production]": {
          "kind": "telemetry-to-cloud-logging"
        }
      }
    },
    "hana": {
      "fuzzy": 0.7
    },
    "websocket": {
      "kind": "socket.io"
    },
    "ord": {
      "namespace": "sap.tutorials",
      "description": "SAP Developer Tutorial Platform — progress tracking, mission management, and real-time event dashboards for developers.sap.com",
      "policyLevels": ["sap:core:v1"],
      "defaultVisibility": "public"
    }
  }
}
