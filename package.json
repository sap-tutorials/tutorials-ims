{
  "name": "tutorials-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-tutorials": "tsx scripts/fetch-tutorials.ts",
    "generate-dark-theme": "tsx scripts/generate-dark-theme.ts",
    "build": "vitepress build site",
    "build:display": "cd display-app && npm install && npm run build",
    "copy:static": "tsx scripts/copy-static.ts",
