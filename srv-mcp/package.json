{
  "name": "tutorials-srv-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "dependencies": {
    "@cap-js/hana": "^3.1.0",
    "@cap-js/mcp": "1.3.0",
    "@sap/cds": "^10.1.0",
    "@sap/xsenv": "^6.2.1",
    "@sap/xssec": "^4.13.1",
    "express": "^5",
    "@tutorials/core": "*",
    "@tutorials/mcp": "*"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "xsuaa"
      },
      "db": {
        "kind": "hana"
      },
      "MainDeveloperService": {
        "kind": "odata-v4",
        "model": "srv-mcp/developer-service",
        "credentials": {
          "url": ""
        },
        "[production]": {
          "credentials": {
            "url": ""
          }
        }
      }
    },
    "mcp": {
      "per_action_tool": true
    }
  }
}
