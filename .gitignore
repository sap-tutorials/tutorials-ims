node_modules/
dist/
site/tutorials/
hugo/content/tutorials/
# Generated per-concept landing pages (issue #446 Track 3-A). Written by
# scripts/fetch-concepts.ts at build time.
hugo/content/concepts/
# Generated per-advocate profile pages (issue #601). Only _index.md is tracked.
hugo/content/developer-advocates/*.md
!hugo/content/developer-advocates/_index.md
hugo/static/tutorials/
hugo/public/
hugo/public-qa/
hugo/content-qa/
approuter/static/*
!approuter/static/login-redirect.html
.tutorial-cache/
.tutorial-cache-qa/
hugo/data/image_dimensions.json
hugo/data/homepage_shelves.json
hugo/data-qa/
hugo/static-qa/
.comparison-results/
.migration-data/
.hana-snapshots/
*.local
.env
.playwright-mcp/
*.png
!docs/public/launch/*.png
!hugo/static/img/advocates-world-map.png
hugo/static/js/*
!hugo/static/js/joule.js
!hugo/static/js/joule-render.js
!hugo/static/js/consent.js
!hugo/static/js/popular-rail.js
!hugo/static/js/vendor/
hugo/static/js/vendor/*
!hugo/static/js/vendor/.gitkeep

# CAP
gen/
db.sqlite
*.db
.cdsrc-private.json
default-env.json

# MTA extension descriptors with resolved secrets (#455). Generated by
# envsubst at deploy time; never commit — they contain real CI secrets.
deploy/*.resolved.mtaext

# Worktrees
.worktrees/
.claude/worktrees/

# Debug / scratch files
_check-*.cjs
cookies.txt

# Build artifacts
mta_archives/
saptutorialsadminshell-*/
app/admin-shell/deploy/
approuter/static/admin-ui/
mta-op-*
srv/data/admin-docs-index.json

# a11y / Lighthouse scan output (regenerated each run)
.lighthouseci/
test/a11y/axe-results.md

# Code-check spike (issue #171) — author-rated CSVs are local artefacts.
# Preflight smoke (issue #278) — verdict JSON also lives here.
/verdicts/*
!/verdicts/.gitkeep

# Hugo build locks
.hugo_build.lock

# srv-qa parsers bundle (generated by prebuild:parsers-bundle)
srv-qa/lib/parsers.bundle.mjs
.scratch/

# VitePress documentation site
docs/.vitepress/dist/
docs/.vitepress/cache/
docs/.vitepress/public/fonts/
docs/public/fonts/

# MediaPipe vendored assets (generated by vendor:mediapipe)
hugo/static/vendor/mediapipe/
.superpowers/

# Per-app package-lock.json — global npmrc has save-exact=true, so per-app
# lock files just add diff noise (#381 PR 6 review feedback).
app/admin/*/package-lock.json
.git-pr-body.md
