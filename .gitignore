# CAP
gen/
db.sqlite
*.db
.cdsrc-private.json
default-env.json

# MTA extension descriptors with resolved secrets (#455). Generated by
# envsubst at deploy time; never commit — they contain real CI secrets.
deploy/*.resolved.mtaext

# Worktrees
.worktrees/
.claude/worktrees/

# Debug / scratch files
_check-*.cjs
cookies.txt

# Build artifacts
# Page-fallback snapshots (written at build time by scripts/build-page-fallback.cjs)
srv/page-fallback/*
!srv/page-fallback/.gitkeep
# What's New digest snapshot (written at build time by scripts/build-whats-new-snapshot.cjs)
srv/whats-new-data/*
!srv/whats-new-data/.gitkeep
mta_archives/
saptutorialsadminshell-*/
app/admin-shell/deploy/
approuter/static/admin-ui/
mta-op-*
srv/data/admin-docs-index.json
# Build metadata for GET /version — written by scripts/deploy-mta.cjs (and CI's
# deploy.yml) before each build; a pure artifact, rewritten every deploy.
srv/version.json

# a11y / Lighthouse scan output (regenerated each run)
.lighthouseci/
test/a11y/axe-results.md

# Code-check spike (issue #171) — author-rated CSVs are local artefacts.
# Preflight smoke (issue #278) — verdict JSON also lives here.
/verdicts/*
!/verdicts/.gitkeep

# Hugo build locks
.hugo_build.lock

# srv-qa parsers bundle (generated by prebuild:parsers-bundle)
srv-qa/lib/parsers.bundle.mjs
.scratch/

# VitePress documentation site
docs/.vitepress/dist/
docs/.vitepress/cache/
docs/.vitepress/public/fonts/
docs/public/fonts/

# MediaPipe vendored assets (generated by vendor:mediapipe)
hugo/static/vendor/mediapipe/

# @imgly background-removal vendored assets (generated by vendor:imgly)
hugo/static/vendor/imgly/
.superpowers/

# Per-app package-lock.json — global npmrc has save-exact=true, so per-app
# lock files just add diff noise (#381 PR 6 review feedback).
app/admin/*/package-lock.json
.git-pr-body.md

# Phase 4 sap-devs MCP cache (sap-devs-client.js)
.cache/

# Generated by scripts/build-explore-manifest.ts (Task 4 of KG public-reader plan).
srv/lib/explore-bundle-manifest.json
# Build artifact written by scripts/build-island-manifest.cjs (alongside
# hugo/data/island_manifest.json) so CAP renderers can resolve content-hashed
# island paths at runtime without Hugo (issue #1604 item 4).
srv/lib/island-manifest.json

# OAuth discovery docs (#1105) — generated at mbt build time from *.template files.
approuter/static/.well-known/oauth-authorization-server
approuter/static/.well-known/oauth-protected-resource
.superpowers/

# Local MCP client config — may hold personal PATs / server URLs; keep out of git.
.mcp.json

# Playwright e2e (#1338) — never commit browser artefacts or auth state.
test-results/
playwright-report/
.playwright-auth-state.json
