{
  "authenticationMethod": "route",
  "responseHeaders": [
    {
      "name": "Content-Security-Policy",
      "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://ui5.sap.com https://www.youtube.com; frame-src https://www.youtube.com; img-src 'self' https://raw.githubusercontent.com https://avatars.githubusercontent.com https://github.com https://*.sap.com data:; style-src 'self' 'unsafe-inline' https://*.sap.com https://ui5.sap.com https://unpkg.com; font-src 'self' https://*.sap.com https://ui5.sap.com https://unpkg.com; connect-src 'self' https://ui5.sap.com https://*.cfapps.eu10-005.hana.ondemand.com wss://*.cfapps.eu10-005.hana.ondemand.com"
    },
    {
      "name": "Content-Signal",
      "value": "index=yes, ai-train=no, ai-search=yes"
    },
    {
      "name": "X-Robots-Tag",
      "value": "index, follow, max-image-preview:large"
    }
  ],
  "login": {
    "callbackEndpoint": "/login/callback"
  },
  "logout": {
    "logoutEndpoint": "/logout",
    "logoutPage": "/"
  },
  "errorPage": [
    { "status": 404, "file": "static/404.html" },
    { "status": 500, "file": "static/500.html" },
    { "status": 503, "file": "static/maintenance.html" }
  ],
  "routes": [
    {
      "source": "^/scanner-ui/(.*)$",
      "target": "/scanner-ui/$1",
      "localDir": "static",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.MobileApp"
    },
    {
      "source": "^/scanner-vue/(.*)$",
      "target": "/scanner-vue/$1",
      "localDir": "static",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.MobileApp"
    },
    {
      "source": "^/scanner/(.*)$",
      "target": "/scanner/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.MobileApp",
      "csrfProtection": false
    },
    {
      "source": "^/admin-ui/(.*)$",
      "target": "/admin-ui/$1",
      "localDir": "static",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.Admin"
    },
    {
      "source": "^/login(\\?.*)?$",
      "authenticationType": "xsuaa",
      "target": "/login-redirect.html",
      "localDir": "static"
    },
    {
      "source": "^/auth/user$",
      "authenticationType": "xsuaa",
      "target": "/auth/user",
      "destination": "srv-api",
      "csrfProtection": false
    },
    {
      "source": "^/admin/(.*)$",
      "target": "/admin/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.Admin",
      "csrfProtection": false
    },
    {
      "source": "^/display/(.*)$",
      "target": "/display/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.DisplayApp",
      "csrfProtection": false
    },
    {
      "source": "^/api/v1/(.*)$",
      "target": "/api/v1/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.ConsolidationScope",
      "csrfProtection": false
    },
    {
      "source": "^/api/ChatConfig(.*)$",
      "target": "/api/ChatConfig$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/chat/(.*)$",
      "target": "/chat/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/search/(.*)$",
      "target": "/search/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/socket\\.io/(.*)$",
      "target": "/socket.io/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/ws/(.*)$",
      "target": "/ws/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/rest/(.*)$",
      "target": "/rest/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/build/(.*)$",
      "target": "/build/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/feedback/(.*)$",
      "target": "/feedback/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/health(/.*)?$",
      "target": "/health$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/.well-known/(.*)$",
      "target": "/.well-known/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/ord/(.*)$",
      "target": "/ord/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/content/(.*)$",
      "target": "/content/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/tutorials/_nav\\.json$",
      "target": "/content/nav",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/tutorials/(.*)$",
      "target": "/content/tutorials/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/_dev/?(.*)$",
      "target": "/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.Admin",
      "csrfProtection": false
    },
    {
      "source": "^/(\\$api-docs/.*)$",
      "target": "/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.Admin",
      "csrfProtection": false
    },
    {
      "source": "^(.*)$",
      "localDir": "static",
      "authenticationType": "none"
    }
  ]
}
