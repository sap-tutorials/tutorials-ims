{
  "build": {
    "target": "gen",
    "tasks": [
      { "for": "hana", "src": "db", "dest": "db" },
      { "for": "nodejs", "src": "srv", "dest": "srv" }
    ]
  },
  "hana": {
    "deploy-format": "hdbtable"
  },
  "odata": {
    "version": "v4"
  },
  "requires": {
    "auth": {
      "kind": "mocked",
      "[hybrid]": { "kind": "xsuaa" },
      "[production]": { "kind": "xsuaa" },
      "users": {
        "developer": {
          "password": "developer",
          "roles": ["DeveloperApp", "authenticated-user"],
          "attr": {
            "email": "dev@test.com",
            "given_name": "Test",
            "family_name": "Developer"
          }
        },
        "admin": {
          "password": "admin",
          "roles": ["Admin", "DeveloperApp", "DisplayApp", "ContentAuthor", "ConsolidationScope", "authenticated-user"]
        },
        "display": {
          "password": "display",
          "roles": ["DisplayApp", "authenticated-user"]
        },
        "consolidation": {
          "password": "consolidation",
          "roles": ["ConsolidationScope", "authenticated-user"]
        }
      }
    },
    "ngds": {
      "kind": "rest",
      "credentials": {
        "url": "http://localhost:0/ngds-mock"
      }
    }
  }
}
