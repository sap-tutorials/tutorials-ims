_schema-version: 3.3.0
ID: tutorials-poc-prod
extends: tutorials-poc

modules:
  - name: tutorials-srv
    parameters:
      instances: 2
    properties:
      CONTENT_API_KEY: ${CONTENT_API_KEY}
      GITHUB_DISPATCH_TOKEN: ${GITHUB_DISPATCH_TOKEN}
      REBUILD_TARGET_ENV: prod
      SMTP_HOST: ${SMTP_HOST}
      SMTP_PORT: ${SMTP_PORT}
      SMTP_USER: ${SMTP_USER}
      SMTP_FROM: ${SMTP_FROM}

  - name: tutorials-approuter
    parameters:
      app-name: tutorials-prod-approuter
      instances: 2
      keep-existing-routes: true
    properties:
      REBUILD_API_KEY: ${REBUILD_API_KEY}
      APPROUTER_URL: ${APPROUTER_URL}

resources:
  - name: tutorials-xsuaa
    parameters:
      service-name: xsuaa-imsprod
