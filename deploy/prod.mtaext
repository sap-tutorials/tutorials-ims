_schema-version: 3.3.0
ID: tutorials-ims-prod
extends: tutorials-ims

modules:
  - name: tutorials-srv
    # No prod-specific `properties:` overrides. CONTENT_API_KEY +
    # GITHUB_DISPATCH_TOKEN are credstore-only (finish-credstore-migration PR;
    # see deploy/dev.mtaext for the rationale), and the KG flags intentionally
    # inherit mta.yaml's 'false' defaults in prod. An empty `properties:` mapping
    # parses as null and the multiapps controller rejects it
    # ("Null value for key modules#0#properties") — so it is omitted, not left blank.
    parameters:
      instances: 2

  - name: tutorials-approuter
    # No prod-specific `properties:` overrides. REBUILD_API_KEY is credstore-only
    # (PR #903 rollout step 3 / #871 follow-up); APPROUTER_URL was removed (no
    # runtime readers). An empty `properties:` mapping parses as null and is
    # rejected by the deployer, so it is omitted rather than left blank.
    parameters:
      app-name: tutorials-prod-approuter
      instances: 2
      keep-existing-routes: true
      # NB: module-level `env:` is silently dropped at deploy time (see dev.mtaext).
      # The former XSUAA_TENANT/XSUAA_REGION/APPROUTER_BASE_URL entries never
      # reached the approuter runtime. OAuth discovery docs (#1105) are generated
      # dynamically from the bound xsuaa VCAP credentials + request host, so no
      # per-env config is needed — the prod tenant/region resolve automatically
      # from the xsuaa-imsprod binding, resolving the old "verify prod tenant" TODO.

resources:
  - name: tutorials-xsuaa
    parameters:
      service-name: xsuaa-imsprod
      # Prod uses a distinct XSUAA descriptor (xsappname: tutorials-prod +
      # ' (Prod)'-suffixed role-collection names). DEV and PROD share ONE
      # subaccount + UAA tenant, and appid = xsappname + tenant while
      # role-collection names are subaccount-global — so prod cannot reuse
      # dev's 'tutorials' xsappname or its bare collection names. Without this
      # override the deploy configures xsuaa-imsprod from the root
      # xs-security.json (xsappname 'tutorials') and collides:
      # "Application with xsappname tutorials!t<n> already exists".
      # xs-security-prod.json is cp'd into .deploy/ by mta.yaml's before-all.
      config-path: xs-security-prod.json

