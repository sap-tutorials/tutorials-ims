_schema-version: 3.3.0
# PROD extension for the MCP-auth microservice MTA (mta-mcp.yaml).
#
# Two prod-specific overrides vs the base descriptor:
#
# 1. tutorials-xsuaa service-name → xsuaa-imsprod. DEV+PROD share one
#    subaccount, so prod's XSUAA instance has a distinct name (xsuaa-imsprod,
#    with xsappname 'tutorials-prod'); it is deployed and OWNED by the main
#    tutorials-ims MTA (see deploy/prod.mtaext:80-82). srv-mcp adopts it as an
#    existing service for the XSUAA-fallback leg of its hybrid auth. The base
#    mta-mcp.yaml hardcodes service-name: tutorials-xsuaa (the DEV name), which
#    does not exist in prod — without this override the MCP MTA deploy fails to
#    resolve the existing service. We only rename the binding target; we do NOT
#    set config-path here (the main MTA owns + configures xsuaa-imsprod from
#    xs-security-prod.json — re-applying it from srv-mcp would collide).
#
# 2. dest-main-srv stays at the base default (tutorials-main-srv-api) — the PROD
#    write-forward destination name. (DEV overrides it to -dev; prod does not.)
#    Destinations are subaccount-level and resolved at runtime via the Cloud SDK;
#    no manual cockpit step is required for prod.
#
# Deploy PROD (from the PRIMARY tree on main; cf target -s prod FIRST):
#   mbt build -e mta-mcp.yaml … && cf deploy mta_archives/*.mtar -e deploy/mcp-prod.mtaext -f
ID: tutorials-mcp-prod
extends: tutorials-mcp

resources:
  - name: tutorials-xsuaa
    parameters:
      service-name: xsuaa-imsprod
