_schema-version: 3.3.0
ID: tutorials-poc-dev
extends: tutorials-poc

modules:
  - name: tutorials-approuter
    parameters:
      app-name: tutorials-dev-approuter
    properties:
      XS_APP_LOG_LEVEL: debug
      DEBUG: "xs-approuter:*"

  - name: tutorials-srv
    properties:
      EXPOSE_CAP_UI: true

resources:
  - name: tutorials-xsuaa
    parameters:
      service-name: xsuaa-imsdev
