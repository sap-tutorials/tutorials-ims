_schema-version: 3.3.0
ID: tutorials-ims-dev
extends: tutorials-ims

# Live DEV gameboard-srv host (sap-community-gameboard MTA, DEV-only today).
# Overrides the invalid base placeholder so the approuter's gameboard-api
# destination resolves. QA/PROD deliberately have NO override yet — their
# /gameboard/* fails loudly until those backends exist (config-cross-env-leak
# guard; see .deploy/mta.yaml parameters).
parameters:
  gameboard-url: https://tutorial-system-dev-gameboard-srv.cfapps.eu10-005.hana.ondemand.com

modules:
  - name: tutorials-srv
    properties:
      EXPOSE_CAP_UI: true
      # CONTENT_API_KEY + GITHUB_DISPATCH_TOKEN previously injected here via
      # envsubst. Removed in the credstore-migration follow-up: srv reads both
      # exclusively from the BTP Credential Store via
      # srv/lib/secret-resolver.js. Rotation happens through
      # /admin-ui/#secrets-display; there is no deploy-time write channel any
      # more. See docs/superpowers/specs/2026-07-04-finish-credstore-migration-design.md
      # for the "two-stores-can-drift" rationale.
      #
      # KG Phase 1 flag flipped 2026-06-19 (#381 / #442). Override the
      # mta.yaml default ('false') so MTA redeploys preserve the DEV-only
      # flip — `cf set-env` overrides do NOT survive `cf deploy` of a new
      # MTA. prod.mtaext / qa.mtaext intentionally inherit 'false' until
      # Phase 1 is signed off.
      KNOWLEDGE_GRAPH_ENABLED: 'true'
      # NOTE: KG_PATH_V2_ENABLED moved to DB-driven config (ImsConfig
      # flag.kg.pathV2, issue #2060). Enable it for DEV from the Admin UI /
      # setFeatureFlag action instead of pinning an env override here.

  - name: tutorials-approuter
    parameters:
      app-name: tutorials-dev-approuter
      # NB: an `env:` block here is silently dropped at deploy time — MTA
      # rejects module-level `env` params ("Parameter(s) {tutorials-approuter=
      # [env]} are not supported… will be lost"). The former XSUAA_TENANT/
      # XSUAA_REGION/APPROUTER_BASE_URL entries never reached the approuter's
      # runtime, which is why the build-time .well-known substitution (#1105)
      # silently produced ${…} placeholders. The OAuth discovery docs are now
      # generated dynamically at runtime from the bound xsuaa VCAP credentials
      # + the request host (approuter/lib/well-known-oauth.js) — no env needed.
    properties:
      XS_APP_LOG_LEVEL: debug
      DEBUG: "xs-approuter:*"
      # REBUILD_API_KEY was formerly injected here via envsubst against
      # deploy.yml's $REBUILD_API_KEY. Removed as the third and final rollout
      # step of PR #871 (issue #903): the approuter now reads REBUILD_API_KEY
      # exclusively from the BTP Credential Store via
      # approuter/lib/credstore-secret.js. APPROUTER_URL followed the same
      # pattern in the finish-credstore-migration PR: it had zero runtime
      # readers so it was removed rather than migrated.
