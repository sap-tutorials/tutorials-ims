_schema-version: 3.3.0
ID: tutorials-poc-dev
extends: tutorials-poc

modules:
  - name: tutorials-srv
    properties:
      EXPOSE_CAP_UI: true
      CONTENT_API_KEY: tutorials-content-publish-2024
      GITHUB_DISPATCH_TOKEN: ${GITHUB_DISPATCH_TOKEN}
      # KG Phase 1 flag flipped 2026-06-19 (#381 / #442). Override the
      # mta.yaml default ('false') so MTA redeploys preserve the DEV-only
      # flip — `cf set-env` overrides do NOT survive `cf deploy` of a new
      # MTA. prod.mtaext / qa.mtaext intentionally inherit 'false' until
      # Phase 1 is signed off.
      KNOWLEDGE_GRAPH_ENABLED: 'true'

  - name: tutorials-approuter
    parameters:
      app-name: tutorials-dev-approuter
    properties:
      XS_APP_LOG_LEVEL: debug
      DEBUG: "xs-approuter:*"
      # Bearer-token gate on POST /admin/rebuild — consumed by rebuild-content.yml
      # workflow's final "Push content to AppRouter" step. Resolved by envsubst
      # against deploy.yml's $REBUILD_API_KEY env (line ~38). qa.mtaext +
      # prod.mtaext already inject; dev was the missing leg of the triple
      # (surfaced by rebuild-content run 28324486225).
      REBUILD_API_KEY: ${REBUILD_API_KEY}
      # Self-URL of this approuter app. Same envsubst plumbing as REBUILD_API_KEY.
      APPROUTER_URL: ${APPROUTER_URL}
