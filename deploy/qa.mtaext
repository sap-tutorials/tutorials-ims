_schema-version: 3.3.0
ID: tutorials-ims-qa
extends: tutorials-ims

modules:
  - name: tutorials-srv
    properties:
      EXPOSE_CAP_UI: true
      CONTENT_API_KEY: ${CONTENT_API_KEY}
      GITHUB_DISPATCH_TOKEN: ${GITHUB_DISPATCH_TOKEN}

  - name: tutorials-approuter
    parameters:
      app-name: tutorials-qa-approuter
    properties:
      # REBUILD_API_KEY was formerly injected here — removed in PR #903
      # rollout step 3 (#871 follow-up). Approuter now reads exclusively
      # from the credstore. See deploy/dev.mtaext for the full rationale.
      APPROUTER_URL: ${APPROUTER_URL}

resources:
  - name: tutorials-xsuaa
    parameters:
      service-name: xsuaa-imsqa
