_schema-version: 3.3.0
ID: tutorials-ims-qa
extends: tutorials-ims

modules:
  - name: tutorials-srv
    properties:
      EXPOSE_CAP_UI: true
      # CONTENT_API_KEY + GITHUB_DISPATCH_TOKEN moved to credstore-only in the
      # finish-credstore-migration PR. See deploy/dev.mtaext for the rationale.

  - name: tutorials-approuter
    # No qa-specific `properties:` overrides. REBUILD_API_KEY is credstore-only
    # (PR #903 rollout step 3 / #871 follow-up); APPROUTER_URL was removed (no
    # runtime readers). An empty `properties:` mapping parses as null and is
    # rejected by the deployer, so it is omitted rather than left blank.
    parameters:
      app-name: tutorials-qa-approuter

resources:
  - name: tutorials-xsuaa
    parameters:
      service-name: xsuaa-imsqa
