{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sap.tutorials.admin.accomplishments",
    "type": "application",
    "title": "Accomplishments",
    "description": "Manage Accomplishments",
    "applicationVersion": { "version": "0.0.1" },
    "dataSources": {
      "mainService": {
        "uri": "/admin/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Accomplishment-manage": {
          "semanticObject": "Accomplishment",
          "action": "manage",
          "title": "Accomplishments",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": { "sap.fe.templates": {} }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "AccomplishmentsList",
          "target": "AccomplishmentsList"
        },
        {
          "pattern": "Accomplishments({key}):?query:",
          "name": "AccomplishmentsObjectPage",
          "target": "AccomplishmentsObjectPage"
        }
      ],
      "targets": {
        "AccomplishmentsList": {
          "type": "Component",
          "id": "AccomplishmentsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Accomplishments",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "Accomplishments": { "detail": { "route": "AccomplishmentsObjectPage" } }
              }
            }
          }
        },
        "AccomplishmentsObjectPage": {
          "type": "Component",
          "id": "AccomplishmentsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Accomplishments",
              "editableHeaderContent": false
            }
          }
        }
      }
    }
  }
}
