{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sap.tutorials.admin.health",
    "type": "application",
    "applicationVersion": { "version": "1.0.0" },
    "title": "URL Health",
    "crossNavigation": {
      "inbounds": {
        "Health-display": {
          "semanticObject": "Health",
          "action": "display",
          "title": "URL Health"
        }
      }
    },
    "dataSources": {
      "adminService": {
        "uri": "/admin/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.m": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "adminService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        { "pattern": ":?query:", "name": "TutorialsHealthList", "target": "TutorialsHealthList" }
      ],
      "targets": {
        "TutorialsHealthList": {
          "type": "Component",
          "id": "TutorialsHealthList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Tutorials",
              "initialLoad": "Enabled",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "columns": {
                    "DataField::slug": { "availability": "Default" },
                    "DataField::linkStatus": { "availability": "Default" },
                    "DataField::lastChecked": { "availability": "Default" },
                    "DataField::linkStatusOverride": { "availability": "Default" }
                  },
                  "actions": {
                    "runUrlHealthScan": {
                      "press": "sap.tutorials.admin.health.ext.MembershipIssues.onRunUrlHealthScan",
                      "visible": true,
                      "enabled": true,
                      "text": "Run scan now"
                    }
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "key": "tab1",
                    "annotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#URLStatus"
                  }
                ]
              },
              "editableHeaderContent": false
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "sap.tutorials.admin.health.ext.MembershipIssues"
          }
        }
      }
    }
  }
}
