{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sap.tutorials.admin.health",
    "type": "application",
    "applicationVersion": { "version": "1.0.0" },
    "title": "URL Health",
    "crossNavigation": {
      "inbounds": {
        "Health-display": {
          "semanticObject": "Health",
          "action": "display",
          "title": "URL Health"
        }
      }
    },
    "dataSources": {
      "adminService": {
        "uri": "/admin/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "sap.tutorials.admin.health.view.Health",
      "type": "XML",
      "id": "health",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.model.odata.v4": {}
      }
    },
    "models": {
      "": {
        "dataSource": "adminService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "contentDensities": { "compact": true, "cozy": true }
  }
}
