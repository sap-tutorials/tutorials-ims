<mvc:View controllerName="sap.tutorials.admin.puzzles.controller.Builder"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:core="sap.ui.core"
  height="100%">

  <Page id="builderPage" title="{b>/pageTitle}" showNavButton="{= ${b>/mode} === 'edit' }"
        navButtonPress=".onNavBack">
    <headerContent>
      <Button text="Create New" type="Emphasized" press=".onCreateNew"
              visible="{= ${b>/mode} === 'list' }"/>
      <Button text="Save" type="Emphasized" press=".onSave"
              visible="{= ${b>/mode} === 'edit' }"/>
      <Button text="Cancel" press=".onNavBack"
              visible="{= ${b>/mode} === 'edit' }"/>
    </headerContent>

    <content>

      <!-- ── LIST MODE ── -->
      <VBox visible="{= ${b>/mode} === 'list' }" class="sapUiSmallMargin">
        <Table id="puzzlesTable" items="{/Puzzles}"
               noDataText="No puzzles yet. Click 'Create New' to start.">
          <columns>
            <Column><Text text="Title"/></Column>
            <Column><Text text="Slug"/></Column>
            <Column><Text text="Status"/></Column>
            <Column width="12rem"><Text text="Actions"/></Column>
          </columns>
          <items>
            <ColumnListItem type="Inactive">
              <cells>
                <Text text="{title}"/>
                <Text text="{slug}"/>
                <ObjectStatus text="{status}"
                  state="{= ${status} === 'ACTIVE' ? 'Success' : ${status} === 'DRAFT' ? 'Warning' : 'None' }"/>
                <HBox>
                  <Button text="Edit" press=".onPuzzlePress" type="Transparent"/>
                  <Button text="Unpublish" press=".onUnpublish" type="Transparent"
                          visible="{= ${path:'status', targetType:'any'} === 'ACTIVE' }"/>
                </HBox>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>

      <!-- ── EDIT MODE ── -->
      <VBox visible="{= ${b>/mode} === 'edit' }" class="sapUiSmallMargin">

        <!-- Title + Slug + Size + Sub-mode -->
        <FlexBox wrap="Wrap" class="sapUiSmallMarginBottom" alignItems="End">
          <VBox width="16rem" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
            <Label text="Title" required="true"/>
            <Input id="titleInput" value="{b>/title}" placeholder="e.g. SAP BTP Basics"/>
          </VBox>
          <VBox width="16rem" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
            <Label text="Slug" required="true"/>
            <Input id="slugInput" value="{b>/slug}" placeholder="e.g. btp-basics"/>
          </VBox>
          <VBox width="6rem" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
            <Label text="Rows"/>
            <Input id="rowsInput" value="{b>/rows}" type="Number" change=".onGridSizeChange"/>
          </VBox>
          <VBox width="6rem" class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
            <Label text="Cols"/>
            <Input id="colsInput" value="{b>/cols}" type="Number" change=".onGridSizeChange"/>
          </VBox>
          <VBox width="10rem" class="sapUiSmallMarginBottom">
            <Label text="Sub-mode"/>
            <SegmentedButton id="subModeBtn" selectedKey="{b>/subMode}" selectionChange=".onSubModeChange">
              <items>
                <SegmentedButtonItem key="design" text="Design"/>
                <SegmentedButtonItem key="fill" text="Fill"/>
              </items>
            </SegmentedButton>
          </VBox>
        </FlexBox>

        <OverflowToolbar class="sapUiSmallMarginBottom">
          <Button text="Clear Grid" icon="sap-icon://clear-all" press=".onClearGrid"/>
          <Button text="Clear Words" icon="sap-icon://eraser" press=".onClearWords"/>
          <ToolbarSeparator/>
          <Button text="Fill Grid" press=".onFillGrid" enabled="{= !${b>/fillRunning} }"/>
          <Button text="Just Fill" press=".onJustFill" enabled="{= !${b>/fillRunning} }"/>
          <Button text="Stop" press=".onStopFill" visible="{b>/fillRunning}"/>
          <ToolbarSeparator/>
          <Button text="Select Grid" icon="sap-icon://grid" press=".onSelectGrid"/>
          <Button text="Save Grid" press=".onSaveGrid"/>
          <ToolbarSpacer/>
          <Button text="Import" icon="sap-icon://upload" press=".onImportPress"/>
          <Button text="Export" icon="sap-icon://download" press=".onExport"/>
          <Button text="Print" icon="sap-icon://print" press=".onPrint"/>
          <Button icon="sap-icon://sys-help" tooltip="Help" press=".onHelp"/>
        </OverflowToolbar>

        <!-- Word list panel -->
        <Panel headerText="Word list" class="sapUiSmallMarginBottom" expandable="true" expanded="true">
          <VBox>
            <TextArea id="wordListArea" value="{b>/wordText}" liveChange=".onWordTextChange"
                      rows="6" width="100%" growing="false"
                      placeholder="Paste words here, one per line (or comma/semicolon separated)…"/>
            <FlexBox alignItems="Center" class="sapUiTinyMarginTop">
              <u:FileUploader id="wordUploader" name="wordlist" fileType="txt,csv"
                              buttonText="Upload a file" placeholder="" width="auto"
                              change=".onUploadWordList" style="Transparent"
                              xmlns:u="sap.ui.unified"/>
              <Button text="Clear" press=".onClearWordList" type="Transparent"
                      visible="{= ${b>/wordText}.length > 0 }" class="sapUiTinyMarginBegin"/>
              <Text text="{= ${b>/wordCount} + ' words' }" class="sapUiTinyMarginBegin"/>
            </FlexBox>
          </VBox>
        </Panel>

        <!-- Grid + Slots panel -->
        <FlexBox alignItems="Start">

          <!-- Grid: rendered via sap.ui.core.HTML; controller rewrites content -->
          <core:HTML id="gridHost" content="&lt;div style='display:inline-block'&gt;&lt;/div&gt;"
                     class="sapUiSmallMarginEnd"/>

          <!-- Slots side panel -->
          <ScrollContainer height="70vh" width="30rem" vertical="true" horizontal="false">
            <VBox>
              <Panel headerText="Suggestions" visible="{= ${b>/suggestions}.length > 0 }"
                     class="sapUiTinyMarginBottom">
                <List items="{ path: 'b>/suggestions', templateShareable: false }">
                  <StandardListItem title="{b>word}" type="Active" press=".onPickSuggestion"/>
                </List>
              </Panel>
              <Title text="Across" titleStyle="H5" class="sapUiTinyMarginBottom"/>
              <List id="acrossList" items="{ path: 'b>/slotsAcross', templateShareable: false }" noDataText="No across slots" showSeparators="Inner">
                <CustomListItem>
                  <FlexBox alignItems="Center" class="sapUiTinyMarginBegin sapUiTinyMarginTop sapUiTinyMarginBottom">
                    <Text text="{b>label}" width="2.5rem" class="sapUiSmallMarginEnd"/>
                    <Input placeholder="Answer" value="{b>answer}" maxLength="32"
                           liveChange=".onAnswerChange" width="7rem" class="sapUiSmallMarginEnd"/>
                    <Input placeholder="Clue" value="{b>clue}" liveChange=".onClueChange" width="10rem"
                           class="sapUiSmallMarginEnd"/>
                    <Select selectedKey="{b>hint}" change=".onHintChange" width="7rem">
                      <core:Item key="" text="(none)"/>
                      <core:Item key="anagram" text="Anagram"/>
                      <core:Item key="hidden" text="Hidden"/>
                      <core:Item key="homophone" text="Homophone"/>
                      <core:Item key="double" text="Double def"/>
                      <core:Item key="cryptic" text="Cryptic"/>
                    </Select>
                  </FlexBox>
                </CustomListItem>
              </List>

              <Title text="Down" titleStyle="H5" class="sapUiSmallMarginTop sapUiTinyMarginBottom"/>
              <List id="downList" items="{ path: 'b>/slotsDown', templateShareable: false }" noDataText="No down slots" showSeparators="Inner">
                <CustomListItem>
                  <FlexBox alignItems="Center" class="sapUiTinyMarginBegin sapUiTinyMarginTop sapUiTinyMarginBottom">
                    <Text text="{b>label}" width="2.5rem" class="sapUiSmallMarginEnd"/>
                    <Input placeholder="Answer" value="{b>answer}" maxLength="32"
                           liveChange=".onAnswerChange" width="7rem" class="sapUiSmallMarginEnd"/>
                    <Input placeholder="Clue" value="{b>clue}" liveChange=".onClueChange" width="10rem"
                           class="sapUiSmallMarginEnd"/>
                    <Select selectedKey="{b>hint}" change=".onHintChange" width="7rem">
                      <core:Item key="" text="(none)"/>
                      <core:Item key="anagram" text="Anagram"/>
                      <core:Item key="hidden" text="Hidden"/>
                      <core:Item key="homophone" text="Homophone"/>
                      <core:Item key="double" text="Double def"/>
                      <core:Item key="cryptic" text="Cryptic"/>
                    </Select>
                  </FlexBox>
                </CustomListItem>
              </List>
            </VBox>
          </ScrollContainer>

        </FlexBox>

        <!-- Fill status strip -->
        <Text text="{b>/fillStatus}" class="sapUiTinyMarginTop" visible="{= ${b>/fillStatus}.length > 0 }"/>

        <!-- Hidden native file input for Import -->
        <core:HTML id="importFileInput"
                   content="&lt;input type='file' accept='.json,application/json' style='display:none'/&gt;"/>

        <!-- Public URL strip (shown after save) -->
        <FlexBox visible="{= !!${b>/savedSlug} }" class="sapUiSmallMarginTop" alignItems="Center">
          <Label text="Public URL:" class="sapUiSmallMarginEnd"/>
          <Link text="{= '/puzzles/' + ${b>/savedSlug} }"
                href="{= '/puzzles/' + ${b>/savedSlug} }" target="_blank"/>
          <Button icon="sap-icon://copy" tooltip="Copy URL" press=".onCopyUrl"
                  class="sapUiTinyMarginBegin" type="Transparent"/>
        </FlexBox>

      </VBox>
    </content>
  </Page>
</mvc:View>
