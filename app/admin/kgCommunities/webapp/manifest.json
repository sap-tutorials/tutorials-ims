{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sap.tutorials.admin.kgCommunities",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appSubtitle}}",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "i18n": "i18n/i18n.properties",
    "dataSources": {
      "mainService": {
        "uri": "/admin/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "KgCommunity-manage": {
          "semanticObject": "KgCommunity",
          "action": "manage",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.fe.templates": {},
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sap.tutorials.admin.kgCommunities.i18n.i18n"
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "KgCommunitiesList",
          "target": "KgCommunitiesList"
        },
        {
          "pattern": "KgCommunities({key}):?query:",
          "name": "KgCommunityObjectPage",
          "target": "KgCommunityObjectPage"
        }
      ],
      "targets": {
        "KgCommunitiesList": {
          "type": "Component",
          "id": "KgCommunitiesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/KgCommunities",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "KgCommunities": {
                  "detail": {
                    "route": "KgCommunityObjectPage"
                  }
                }
              }
            }
          }
        },
        "KgCommunityObjectPage": {
          "type": "Component",
          "id": "KgCommunityObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/KgCommunities",
              "editableHeaderContent": false
            }
          }
        }
      }
    }
  }
}
