{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sap.tutorials.admin.contentModeration",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "0.0.1" },
    "i18n": "i18n/i18n.properties",
    "dataSources": {
      "mainService": {
        "uri": "/content-moderation/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ContentModeration-manage": {
          "semanticObject": "ContentModeration",
          "action": "manage",
          "title": "{{appTitle}}",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": { "sap.fe.templates": {} }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "sap.tutorials.admin.contentModeration.i18n.i18n" }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "NewsItemsList",
          "target": "NewsItemsList"
        },
        {
          "pattern": "NewsItems({key}):?query:",
          "name": "NewsItemsObjectPage",
          "target": "NewsItemsObjectPage"
        },
        {
          "pattern": "seeds:?query:",
          "name": "SeedsList",
          "target": "SeedsList"
        }
      ],
      "targets": {
        "NewsItemsList": {
          "type": "Component",
          "id": "NewsItemsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/NewsItems",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "NewsItems": { "detail": { "route": "NewsItemsObjectPage" } }
              }
            }
          }
        },
        "NewsItemsObjectPage": {
          "type": "Component",
          "id": "NewsItemsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/NewsItems",
              "editableHeaderContent": false
            }
          }
        },
        "SeedsList": {
          "type": "Component",
          "id": "SeedsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/RelevanceSeedExemplars",
              "variantManagement": "Page",
              "initialLoad": "Enabled"
            }
          }
        }
      }
    }
  }
}
