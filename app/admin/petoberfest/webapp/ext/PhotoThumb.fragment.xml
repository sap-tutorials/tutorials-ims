<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns:m="sap.m">
  <!-- Issue #2597 / follow-up: the thumbnail is a plain preview. Clicking the
       row (including this cell) navigates to the submission ObjectPage, which
       shows the full-size photo — there is no separate enlarge dialog. -->
  <m:Image
    src="{= '/admin/petoberfest/photo/' + ${ID} + '?size=thumb' }"
    width="60px"
    height="60px"
    densityAware="false"
    alt="{= 'Photo of ' + (${petName} || 'submission') }"
    class="sapUiTinyMargin" />
</core:FragmentDefinition>
