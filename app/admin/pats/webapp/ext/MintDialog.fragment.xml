<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  <!-- #1132: Mint a new Personal Access Token. Bound to the `mint` JSON model
       (name / scopes / ttlDays). On Mint → PatService.mintPAT → the plaintext
       token is shown ONCE in the reveal dialog (MintedTokenDialog fragment). -->
  <Dialog
    id="patMintDialog"
    title="{i18n>mint.dialogTitle}"
    contentWidth="480px"
    contentHeight="auto">
    <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
      <Label text="{i18n>mint.fieldName}" required="true" />
      <Input value="{mint>/name}" placeholder="{i18n>mint.fieldNamePlaceholder}" maxLength="80" />

      <Label text="{i18n>mint.fieldScopes}" required="true" />
      <MultiComboBox
        id="patMintScopes"
        selectedKeys="{mint>/scopes}"
        placeholder="{i18n>mint.fieldScopesPlaceholder}">
        <core:Item key="read" text="read" />
        <core:Item key="write" text="write" />
        <!-- #2857: `admin` scope — hidden by default; onMintToken makes it
             visible ONLY when PatService.patCapabilities().adminScopeAvailable
             is true (flag ON AND caller holds the Tutorials Admin role). A
             non-admin never sees it, so can't mint a PAT that would 403. -->
        <core:Item id="patMintScopeAdmin" key="admin" text="admin" visible="false" />
      </MultiComboBox>
      <!-- #2857: explains the admin scope; shown only when the admin item is. -->
      <Label text="" />
      <Text id="patMintAdminHint" text="{i18n>mint.adminScopeHint}" visible="false" />

      <Label text="{i18n>mint.fieldTtl}" />
      <StepInput
        value="{mint>/ttlDays}"
        min="1"
        max="365"
        step="1"
        description="{i18n>mint.fieldTtlUnit}" />
    </f:SimpleForm>

    <buttons>
      <Button
        text="{i18n>mint.buttonMint}"
        type="Emphasized"
        icon="sap-icon://add"
        press=".onMintConfirm" />
      <Button text="{i18n>mint.buttonCancel}" press=".onMintCancel" />
    </buttons>
  </Dialog>
</core:FragmentDefinition>
