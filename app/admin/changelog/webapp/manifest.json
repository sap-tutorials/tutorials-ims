{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sap.tutorials.admin.changelog",
    "type": "application",
    "title": "Change Log",
    "description": "View all tracked changes across entities",
    "applicationVersion": { "version": "0.0.1" },
    "dataSources": {
      "mainService": {
        "uri": "/admin/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ChangeLog-display": {
          "semanticObject": "ChangeLog",
          "action": "display",
          "title": "Change Log",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": { "sap.fe.templates": {} }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ChangeLogList",
          "target": "ChangeLogList"
        }
      ],
      "targets": {
        "ChangeLogList": {
          "type": "Component",
          "id": "ChangeLogList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ChangeLog",
              "variantManagement": "Page",
              "initialLoad": "Enabled"
            }
          }
        }
      }
    }
  }
}
