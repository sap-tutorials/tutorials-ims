<mvc:View
  controllerName="sap.tutorials.admin.uiEvents.controller.Settings"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core"
  height="100%">
  <ScrollContainer height="100%" width="100%" vertical="true" horizontal="false">
    <VBox class="sapUiMediumMargin">
      <Title text="{i18n>pageTitle}" level="H2" class="sapUiSmallMarginBottom" />

      <MessageStrip
        text="{i18n>infoText}"
        type="Information"
        showIcon="true"
        class="sapUiSmallMarginBottom" />

      <Panel headerText="{i18n>generalHeader}" class="sapUiSmallMarginBottom">
        <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
          <Label text="{i18n>fieldEnabled}" />
          <Switch state="{settings>/enabled}" />
        </f:SimpleForm>
      </Panel>

      <HBox class="sapUiSmallMarginTop">
        <Button text="{i18n>btnSave}" press=".onSave" type="Emphasized" class="sapUiTinyMarginEnd" />
        <Button text="{i18n>btnReload}" press=".onReload" />
      </HBox>
    </VBox>
  </ScrollContainer>
</mvc:View>
