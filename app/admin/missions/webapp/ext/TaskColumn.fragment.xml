<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  xmlns:macros="sap.fe.macros">
  <VBox>
    <macros:Field
      readOnly="false"
      metaPath="tutorial_ID"
      visible="{= ${taskType} === 'TUTORIAL'}"/>
    <macros:Field
      readOnly="false"
      metaPath="group_ID"
      visible="{= ${taskType} === 'GROUP'}"/>
    <Input
      value="{checkpointTitle}"
      visible="{= ${taskType} === 'CHECKPOINT'}"
      placeholder="Checkpoint title"/>
  </VBox>
</core:FragmentDefinition>
