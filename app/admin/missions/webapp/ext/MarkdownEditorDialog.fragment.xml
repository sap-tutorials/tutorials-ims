<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout">
  <Dialog
    id="markdownEditorDialog"
    title="Markdown Editor"
    stretch="true"
    contentHeight="90%"
    contentWidth="95%">
    <content>
      <l:Splitter height="100%">
        <l:contentAreas>
          <TextArea
            id="markdownCodeEditor"
            height="100%"
            width="100%"
            growing="false"
            wrapping="Off"
            liveChange=".onEditorChange"
            class="sapTutorialsMarkdownTextArea">
            <layoutData>
              <l:SplitterLayoutData size="50%" minSize="200"/>
            </layoutData>
          </TextArea>
          <ScrollContainer
            id="markdownPreviewContainer"
            height="100%"
            vertical="true"
            horizontal="false">
            <layoutData>
              <l:SplitterLayoutData size="50%"/>
            </layoutData>
            <VBox class="sapUiSmallMargin">
              <FormattedText
                id="markdownPreview"
                htmlText=""/>
            </VBox>
          </ScrollContainer>
        </l:contentAreas>
      </l:Splitter>
    </content>
    <beginButton>
      <Button
        id="markdownSaveBtn"
        text="Save"
        type="Emphasized"
        press=".onSaveMarkdown"/>
    </beginButton>
    <endButton>
      <Button
        id="markdownCancelBtn"
        text="Cancel"
        press=".onCancelMarkdown"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
