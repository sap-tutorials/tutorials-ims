<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  xmlns:dnd="sap.ui.core.dnd"
  core:require="{ handler: 'sap/tutorials/admin/missions/ext/ItemReorder.controller' }">
  <Table id="itemReorderTable" items="{path: 'items', parameters: {$$ownRequest: true}, sorter: {path: 'itemOrder'}}" mode="None">
    <dragDropConfig>
      <dnd:DragDropInfo
        sourceAggregation="items"
        targetAggregation="items"
        dropPosition="Between"
        enabled="{= !${IsActiveEntity} }"
        drop="handler.onDrop"/>
    </dragDropConfig>
    <columns>
      <Column width="3rem" hAlign="Center"><Text text=""/></Column>
      <Column width="5rem"><Text text="Order"/></Column>
      <Column width="7rem"><Text text="Type"/></Column>
      <Column><Text text="Task"/></Column>
    </columns>
    <items>
      <ColumnListItem>
        <cells>
          <core:Icon src="sap-icon://menu2"/>
          <ObjectNumber number="{itemOrder}" emphasized="false"/>
          <Text text="{taskType}"/>
          <Text text="{taskName}"/>
        </cells>
      </ColumnListItem>
    </items>
  </Table>
</core:FragmentDefinition>
