<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  xmlns:dnd="sap.ui.core.dnd"
  core:require="{ Handler: 'sap/tutorials/admin/missions/ext/ItemReorderHandler' }">
  <!--
    `core:require` here ensures the handler module is loaded (so it self-
    publishes to `sap.tutorials.admin.missions.ext.ItemReorderHandler`) before
    drop events can fire. The `drop=` attribute uses a fully-qualified path
    rather than the alias because EventHandlerResolver does NOT receive
    `core:require` aliases via mLocals when this fragment is loaded by the
    FE V4 custom-section template loader. See ItemReorderHandler.js for the
    full rationale — short version: every prior `handler.onDrop`-based fix
    attempt for issue #70 silently failed because UI5 logs only a Log.warning
    when an event handler can't be resolved.
  -->
  <Table id="itemReorderTable" items="{path: 'items', parameters: {$$ownRequest: true}, sorter: {path: 'itemOrder'}}" mode="None">
    <dragDropConfig>
      <dnd:DragDropInfo
        sourceAggregation="items"
        targetAggregation="items"
        dropPosition="Between"
        enabled="{= !%{IsActiveEntity} }"
        drop="sap.tutorials.admin.missions.ext.ItemReorderHandler.onDrop"/>
    </dragDropConfig>
    <columns>
      <Column width="3rem" hAlign="Center"><Text text=""/></Column>
      <Column width="5rem"><Text text="Order"/></Column>
      <Column width="7rem"><Text text="Type"/></Column>
      <Column><Text text="Task"/></Column>
    </columns>
    <items>
      <ColumnListItem>
        <cells>
          <core:Icon src="sap-icon://menu2"/>
          <ObjectNumber number="{itemOrder}" emphasized="false"/>
          <Text text="{taskType}"/>
          <Text text="{taskName}"/>
        </cells>
      </ColumnListItem>
    </items>
  </Table>
</core:FragmentDefinition>
