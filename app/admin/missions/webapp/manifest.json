{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sap.tutorials.admin.missions",
    "type": "application",
    "title": "Missions",
    "description": "Manage Missions",
    "applicationVersion": {
      "version": "0.0.2"
    },
    "dataSources": {
      "mainService": {
        "uri": "/admin/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Mission-manage": {
          "semanticObject": "Mission",
          "action": "manage",
          "title": "Missions",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.fe.templates": {},
        "sap.f": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "flexibleColumnLayout": {
          "defaultTwoColumnLayoutType": "TwoColumnsMidExpanded",
          "defaultThreeColumnLayoutType": "ThreeColumnsMidExpanded"
        }
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "MissionsList",
          "target": [
            "MissionsList"
          ]
        },
        {
          "pattern": "Missions({key}):?query:",
          "name": "MissionsObjectPage",
          "target": [
            "MissionsList",
            "MissionsObjectPage"
          ]
        },
        {
          "pattern": "Missions({key})/completionPaths({key2}):?query:",
          "name": "CompletionPathsObjectPage",
          "target": [
            "MissionsList",
            "MissionsObjectPage",
            "CompletionPathsObjectPage"
          ]
        }
      ],
      "targets": {
        "MissionsList": {
          "type": "Component",
          "id": "MissionsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Missions",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "Missions": {
                  "detail": {
                    "route": "MissionsObjectPage"
                  }
                }
              }
            }
          },
          "controlAggregation": "beginColumnPages",
          "contextPattern": ""
        },
        "MissionsObjectPage": {
          "type": "Component",
          "id": "MissionsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Missions",
              "editableHeaderContent": false,
              "content": {
                "header": {
                  "actions": {
                    "EditMarkdown": {
                      "press": "sap.tutorials.admin.missions.ext.MarkdownEditor.onEditMarkdown",
                      "text": "Edit Description (Markdown)"
                    }
                  }
                }
              },
              "navigation": {
                "completionPaths": {
                  "detail": {
                    "route": "CompletionPathsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "completionPaths/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "creationMode": {
                      "name": "Inline",
                      "createAtEnd": true
                    }
                  }
                }
              }
            }
          },
          "controlAggregation": "midColumnPages",
          "contextPattern": "/Missions({key})"
        },
        "CompletionPathsObjectPage": {
          "type": "Component",
          "id": "CompletionPathsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Missions/completionPaths",
              "editableHeaderContent": false,
              "content": {
                "body": {
                  "sections": {
                    "ItemReorderSection": {
                      "template": "sap.tutorials.admin.missions.ext.ItemReorder",
                      "title": "Path Items (Drag to Reorder)",
                      "position": {
                        "anchor": "ItemsSection",
                        "placement": "After"
                      }
                    }
                  }
                }
              },
              "controlConfiguration": {
                "items/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "creationMode": {
                      "name": "Inline",
                      "createAtEnd": true
                    }
                  },
                  "columns": {
                    "TypeColumn": {
                      "header": "Type",
                      "width": "10em",
                      "importance": "High",
                      "position": {
                        "placement": "Before",
                        "anchor": "DataField::prize_ID"
                      },
                      "template": "sap.tutorials.admin.missions.ext.TypeColumn",
                      "availability": "Default"
                    },
                    "TaskColumn": {
                      "header": "Task",
                      "width": "20em",
                      "importance": "High",
                      "position": {
                        "placement": "After",
                        "anchor": "TypeColumn"
                      },
                      "template": "sap.tutorials.admin.missions.ext.TaskColumn",
                      "availability": "Default"
                    },
                    "DataField::tutorial_ID": {
                      "availability": "Hidden"
                    },
                    "DataField::group_ID": {
                      "availability": "Hidden"
                    },
                    "DataField::checkpointTitle": {
                      "availability": "Hidden"
                    }
                  }
                }
              }
            }
          },
          "controlAggregation": "endColumnPages",
          "contextPattern": "/Missions({key})/completionPaths({key2})"
        }
      }
    },
    "rootView": {
      "viewName": "sap.fe.templates.RootContainer.view.Fcl",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    }
  }
}
