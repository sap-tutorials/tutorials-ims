{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sap.tutorials.admin.ngds",
    "type": "application",
    "title": "{{appTitle}}",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "0.0.1" }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "sap.tutorials.admin.ngds.view.Settings",
      "type": "XML",
      "id": "settings",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "sap.tutorials.admin.ngds.i18n.i18n" }
      }
    },
    "contentDensities": { "compact": true, "cozy": true }
  }
}
