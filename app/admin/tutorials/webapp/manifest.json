{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sap.tutorials.admin.tutorials",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "Tutorials",
    "description": "View Tutorials",
    "applicationVersion": { "version": "0.0.1" },
    "dataSources": {
      "mainService": {
        "uri": "/admin/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Tutorial-display": {
          "semanticObject": "Tutorial",
          "action": "display",
          "title": "Tutorials",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": { "sap.fe.templates": {} }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sap.tutorials.admin.tutorials.i18n.i18n"
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "sap.tutorials.admin.tutorials.ext.RebuildTutorial"
          }
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "TutorialsList",
          "target": "TutorialsList"
        },
        {
          "pattern": "Tutorials({key}):?query:",
          "name": "TutorialsObjectPage",
          "target": "TutorialsObjectPage"
        }
      ],
      "targets": {
        "TutorialsList": {
          "type": "Component",
          "id": "TutorialsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Tutorials",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "Tutorials": { "detail": { "route": "TutorialsObjectPage" } }
              }
            }
          }
        },
        "TutorialsObjectPage": {
          "type": "Component",
          "id": "TutorialsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Tutorials",
              "editableHeaderContent": false,
              "content": {
                "header": {
                  "actions": {
                    "AskJouleAction": {
                      "press": "sap.tutorials.admin.tutorials.ext.AskJoule.onAskJoule",
                      "text": "Ask Joule for tutorial improvement suggestions"
                    }
                  }
                },
                "body": {
                  "sections": {
                    "SourceMarkdown": {
                      "template": "sap.tutorials.admin.tutorials.ext.SourceMarkdownSection",
                      "position": {
                        "placement": "After",
                        "anchor": "ContributorsFacet"
                      },
                      "title": "Source Markdown"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "sap.tutorials.admin.tutorials.ext.SourceMarkdownHandler"
          }
        }
      }
    }
  }
}
