<core:FragmentDefinition
  xmlns:core="sap.ui.core"
  xmlns="sap.m"
  xmlns:dnd="sap.ui.core.dnd"
  core:require="{ Handler: 'sap/tutorials/admin/groups/ext/ItemReorderHandler' }">
  <!--
    `core:require` here is intentional but NOT what wires the drop event — its
    role is to ensure the handler module is loaded (and thus self-publishes to
    `sap.tutorials.admin.groups.ext.ItemReorderHandler`) before drop events can
    fire. The `drop=` attribute below uses a fully-qualified globalThis path
    instead of `Handler.onDrop` because EventHandlerResolver does NOT receive
    `core:require` aliases via mLocals when the fragment is loaded by the
    FE V4 custom-section template loader (verified live in DEV against UI5
    1.136.0; see ItemReorderHandler.js header comment for full rationale and
    why every prior `handler.onDrop`-based fix attempt failed silently).
  -->
  <Table id="itemReorderTable" items="{path: 'items', parameters: {$$ownRequest: true, $expand: 'tutorial($select=title,slug)'}, sorter: {path: 'itemOrder'}}" mode="None">
    <dragDropConfig>
      <dnd:DragDropInfo
        sourceAggregation="items"
        targetAggregation="items"
        dropPosition="Between"
        enabled="{= !%{IsActiveEntity} }"
        drop="sap.tutorials.admin.groups.ext.ItemReorderHandler.onDrop"/>
    </dragDropConfig>
    <columns>
      <Column width="3rem" hAlign="Center"><Text text=""/></Column>
      <Column width="5rem"><Text text="Order"/></Column>
      <Column><Text text="Tutorial"/></Column>
      <Column><Text text="Slug"/></Column>
    </columns>
    <items>
      <ColumnListItem>
        <cells>
          <core:Icon src="sap-icon://menu2"/>
          <ObjectNumber number="{itemOrder}" emphasized="false"/>
          <Text text="{tutorial/title}"/>
          <Text text="{tutorial/slug}"/>
        </cells>
      </ColumnListItem>
    </items>
  </Table>
</core:FragmentDefinition>
