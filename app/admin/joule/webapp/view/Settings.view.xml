<mvc:View
  controllerName="sap.tutorials.admin.joule.controller.Settings"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core"
  height="100%">
  <ScrollContainer height="100%" width="100%" vertical="true" horizontal="false">
    <VBox class="sapUiMediumMargin">
      <Title text="{i18n>pageTitle}" level="H2" class="sapUiSmallMarginBottom" />

      <Panel headerText="{i18n>generalHeader}" class="sapUiSmallMarginBottom">
        <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
          <Label text="{i18n>fieldEnabled}" />
          <Switch state="{settings>/enabled}" />

          <Label text="{i18n>fieldDeploymentId}" />
          <Input value="{settings>/deploymentId}" placeholder="{i18n>placeholderDeploymentId}" />

          <Label text="{i18n>fieldModelName}" />
          <Input value="{settings>/modelName}" placeholder="{i18n>placeholderModelName}" />

          <Label text="{i18n>fieldTemperature}" />
          <Input value="{settings>/temperature}" type="Number" placeholder="{i18n>placeholderTemperature}" />

          <Label text="{i18n>fieldMaxTokens}" />
          <Input value="{settings>/maxTokens}" type="Number" placeholder="{i18n>placeholderMaxTokens}" />

          <Label text="{i18n>fieldMaxRequests}" />
          <Input value="{settings>/maxRequestsPerUser}" type="Number" />

          <Label text="{i18n>fieldBannerText}" />
          <TextArea value="{settings>/bannerText}" rows="3" growing="true" growingMaxLines="6" width="100%" />
        </f:SimpleForm>
      </Panel>

      <Panel headerText="{i18n>ragSection}" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
        <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
          <Label text="{i18n>ragEnabled}" />
          <Switch state="{settings>/ragEnabled}" />

          <Label text="{i18n>embeddingModel}" />
          <Input value="{settings>/embeddingModel}" />

          <Label text="{i18n>embeddingTopK}" />
          <StepInput value="{settings>/embeddingTopK}" min="1" max="10" />

          <Label text="{i18n>embeddingMinScore}" />
          <Input value="{settings>/embeddingMinScore}" type="Number" />
        </f:SimpleForm>
        <Toolbar>
          <Button text="{i18n>seedButton}" press=".onSeedEmbeddings" type="Emphasized" enabled="{settings>/ragEnabled}" />
        </Toolbar>
        <VBox class="sapUiSmallMargin">
          <Title text="{i18n>ragStatsTitle}" level="H4" />
          <Text text="{stats>/slugsDisplay}" />
          <Text text="{stats>/stepsDisplay}" />
          <Text text="{stats>/lastRunDisplay}" />
        </VBox>
      </Panel>

      <!-- AI grading toggles. Both default off in the schema (db/schema.cds:519,523).
           Flipping either on starts AI Core token consumption per submission;
           the help text under each label says so explicitly so an admin doesn't
           switch them on without realizing. The two flags are surfaced together
           because they share the same operator-decision shape: "are we paying
           for AI-graded learner submissions on this channel?" -->
      <Panel headerText="{i18n>aiGradingSection}" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
        <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
          <Label text="{i18n>validateAnswerEnabled}" />
          <Switch state="{settings>/validateAnswerEnabled}" />

          <Label text="" />
          <Text text="{i18n>validateAnswerEnabledHelp}" wrapping="true" class="sapUiTinyMarginBottom" />

          <Label text="{i18n>codeCheckEnabled}" />
          <Switch state="{settings>/codeCheckEnabled}" />

          <Label text="" />
          <Text text="{i18n>codeCheckEnabledHelp}" wrapping="true" />
        </f:SimpleForm>
      </Panel>

      <!-- Issue #172 pilot master flag. Default OFF in the schema
           (db/schema.cds:530). When off, the public /api/ChatConfig
           singleton reports branchingEnabled=false; the Learning
           Preferences island in /me/ shows the "Branching is currently
           disabled platform-wide" info strip, and the
           getBranchRecommendation Joule tool is NOT registered. Flipping
           on activates the branch recommender, the tool, and mission
           alt-group rendering. Rollout procedure documented in
           docs/authors/pilot-runbook.md (Phase 3). -->
      <Panel headerText="{i18n>branchingSection}" expandable="true" expanded="true" class="sapUiSmallMarginBottom">
        <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
          <Label text="{i18n>branchingEnabled}" />
          <Switch state="{settings>/branchingEnabled}" />

          <Label text="" />
          <Text text="{i18n>branchingEnabledHelp}" wrapping="true" />
        </f:SimpleForm>
      </Panel>

      <HBox class="sapUiSmallMarginTop">
        <Button text="{i18n>btnSave}" press=".onSave" type="Emphasized" class="sapUiTinyMarginEnd" />
        <Button text="{i18n>btnReload}" press=".onReload" />
      </HBox>
    </VBox>
  </ScrollContainer>
</mvc:View>
