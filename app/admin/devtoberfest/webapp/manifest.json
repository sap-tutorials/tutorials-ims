{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sap.tutorials.admin.devtoberfest",
    "type": "application",
    "title": "Devtoberfest",
    "description": "Manage Devtoberfest configurations (multi-row + draft-enabled)",
    "applicationVersion": { "version": "0.0.2" },
    "dataSources": {
      "mainService": {
        "uri": "/admin/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Devtoberfest-manage": {
          "semanticObject": "Devtoberfest",
          "action": "manage",
          "title": "Devtoberfest",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": { "sap.fe.templates": {} }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "DevtoberfestConfigList",
          "target": "DevtoberfestConfigList"
        },
        {
          "pattern": "DevtoberfestConfig({key}):?query:",
          "name": "DevtoberfestConfigObjectPage",
          "target": "DevtoberfestConfigObjectPage"
        }
      ],
      "targets": {
        "DevtoberfestConfigList": {
          "type": "Component",
          "id": "DevtoberfestConfigList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/DevtoberfestConfig",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "DevtoberfestConfig": { "detail": { "route": "DevtoberfestConfigObjectPage" } }
              }
            }
          }
        },
        "DevtoberfestConfigObjectPage": {
          "type": "Component",
          "id": "DevtoberfestConfigObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/DevtoberfestConfig",
              "editableHeaderContent": false
            }
          }
        }
      }
    }
  }
}
