{
  "_version": "1.65.0",
  "sap.cloud": {
    "service": "tutorials",
    "public": true
  },
  "sap.app": {
    "id": "sap.tutorials.admin.shell",
    "type": "application",
    "title": "Admin Console",
    "description": "Unified admin shell for tutorial platform management",
    "applicationVersion": { "version": "0.0.1" },
    "dataSources": {
      "adminService": {
        "uri": "/admin/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.tnt": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.table": {},
        "sap.suite.ui.microchart": {}
      }
    },
    "resourceRoots": {
      "sap.tutorials.admin.events": "./components/events",
      "sap.tutorials.admin.missions": "./components/missions",
      "sap.tutorials.admin.groups": "./components/groups",
      "sap.tutorials.admin.tutorials": "./components/tutorials",
      "sap.tutorials.admin.tags": "./components/tags",
      "sap.tutorials.admin.accomplishments": "./components/accomplishments",
      "sap.tutorials.admin.prizes": "./components/prizes",
      "sap.tutorials.admin.operations": "./components/operations",
      "sap.tutorials.admin.accounts": "./components/accounts",
      "sap.tutorials.admin.changelog": "./components/changelog"
    },
    "models": {
      "admin": {
        "dataSource": "adminService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": false
        }
      }
    },
    "componentUsages": {
      "eventsComponent": {
        "name": "sap.tutorials.admin.events",
        "settings": {},
        "componentData": {},
        "lazy": true
      },
      "missionsComponent": {
        "name": "sap.tutorials.admin.missions",
        "settings": {},
        "componentData": {},
        "lazy": true
      },
      "groupsComponent": {
        "name": "sap.tutorials.admin.groups",
        "settings": {},
        "componentData": {},
        "lazy": true
      },
      "tutorialsComponent": {
        "name": "sap.tutorials.admin.tutorials",
        "settings": {},
        "componentData": {},
        "lazy": true
      },
      "tagsComponent": {
        "name": "sap.tutorials.admin.tags",
        "settings": {},
        "componentData": {},
        "lazy": true
      },
      "accomplishmentsComponent": {
        "name": "sap.tutorials.admin.accomplishments",
        "settings": {},
        "componentData": {},
        "lazy": true
      },
      "prizesComponent": {
        "name": "sap.tutorials.admin.prizes",
        "settings": {},
        "componentData": {},
        "lazy": true
      },
      "operationsComponent": {
        "name": "sap.tutorials.admin.operations",
        "settings": {},
        "componentData": {},
        "lazy": true
      },
      "accountsComponent": {
        "name": "sap.tutorials.admin.accounts",
        "settings": {},
        "componentData": {},
        "lazy": true
      },
      "changelogComponent": {
        "name": "sap.tutorials.admin.changelog",
        "settings": {},
        "componentData": {},
        "lazy": true
      }
    },
    "services": {
      "ShellUIService": {
        "factoryName": "sap.tutorials.admin.shell.services.ShellUIService"
      }
    },
    "rootView": {
      "viewName": "sap.tutorials.admin.shell.view.Shell",
      "type": "XML",
      "id": "shell"
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "async": true,
        "viewType": "XML",
        "viewPath": "sap.tutorials.admin.shell.view",
        "controlId": "contentArea",
        "controlAggregation": "pages",
        "clearControlAggregation": false
      },
      "routes": [
        { "name": "events", "pattern": "events", "target": [{"name": "eventsTarget", "prefix": "ev"}] },
        { "name": "missions", "pattern": "missions", "target": [{"name": "missionsTarget", "prefix": "mi"}] },
        { "name": "groups", "pattern": "groups", "target": [{"name": "groupsTarget", "prefix": "gr"}] },
        { "name": "tutorials", "pattern": "tutorials", "target": [{"name": "tutorialsTarget", "prefix": "tu"}] },
        { "name": "tags", "pattern": "tags", "target": [{"name": "tagsTarget", "prefix": "ta"}] },
        { "name": "accomplishments", "pattern": "accomplishments", "target": [{"name": "accomplishmentsTarget", "prefix": "ac"}] },
        { "name": "prizes", "pattern": "prizes", "target": [{"name": "prizesTarget", "prefix": "pr"}] },
        { "name": "operations", "pattern": "operations", "target": [{"name": "operationsTarget", "prefix": "op"}] },
        { "name": "accounts", "pattern": "accounts", "target": [{"name": "accountsTarget", "prefix": "au"}] },
        { "name": "changelog", "pattern": "changelog", "target": [{"name": "changelogTarget", "prefix": "cl"}] },
        { "name": "board", "pattern": "board", "target": "boardTarget" },
        { "name": "dashboard", "pattern": "", "target": "dashboardTarget" },
        { "name": "statistics", "pattern": "statistics", "target": "statisticsTarget" },
        { "name": "privacy", "pattern": "privacy", "target": "privacyTarget" }
      ],
      "targets": {
        "eventsTarget": {
          "type": "Component",
          "usage": "eventsComponent",
          "id": "eventsTarget",
          "viewLevel": 1,
          "prefix": "ev"
        },
        "missionsTarget": {
          "type": "Component",
          "usage": "missionsComponent",
          "id": "missionsTarget",
          "viewLevel": 1,
          "prefix": "mi"
        },
        "groupsTarget": {
          "type": "Component",
          "usage": "groupsComponent",
          "id": "groupsTarget",
          "viewLevel": 1,
          "prefix": "gr"
        },
        "tutorialsTarget": {
          "type": "Component",
          "usage": "tutorialsComponent",
          "id": "tutorialsTarget",
          "viewLevel": 1,
          "prefix": "tu"
        },
        "tagsTarget": {
          "type": "Component",
          "usage": "tagsComponent",
          "id": "tagsTarget",
          "viewLevel": 1,
          "prefix": "ta"
        },
        "accomplishmentsTarget": {
          "type": "Component",
          "usage": "accomplishmentsComponent",
          "id": "accomplishmentsTarget",
          "viewLevel": 1,
          "prefix": "ac"
        },
        "prizesTarget": {
          "type": "Component",
          "usage": "prizesComponent",
          "id": "prizesTarget",
          "viewLevel": 1,
          "prefix": "pr"
        },
        "operationsTarget": {
          "type": "Component",
          "usage": "operationsComponent",
          "id": "operationsTarget",
          "viewLevel": 1,
          "prefix": "op"
        },
        "accountsTarget": {
          "type": "Component",
          "usage": "accountsComponent",
          "id": "accountsTarget",
          "viewLevel": 1,
          "prefix": "au"
        },
        "changelogTarget": {
          "type": "Component",
          "usage": "changelogComponent",
          "id": "changelogTarget",
          "viewLevel": 1,
          "prefix": "cl"
        },
        "boardTarget": {
          "viewName": "Board",
          "viewLevel": 1
        },
        "dashboardTarget": {
          "viewName": "TutorialDashboard",
          "viewLevel": 1
        },
        "statisticsTarget": {
          "viewName": "Statistics",
          "viewLevel": 1
        },
        "privacyTarget": {
          "viewName": "Privacy",
          "viewLevel": 1
        }
      },
      "bypassed": {
        "target": "dashboardTarget"
      }
    }
  }
}
