<mvc:View
  controllerName="sap.tutorials.admin.shell.controller.Privacy"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m">
  <Page title="Privacy">
    <content>
      <Wizard id="privacyWizard" complete=".onWizardComplete">
        <WizardStep title="Request Info" id="step1">
          <VBox class="sapUiSmallMargin">
            <Label text="PET Number / SAP ID (C-Number)" required="true"/>
            <Input id="sapIdInput" placeholder="e.g., C1234567"/>
            <Label text="DSR Request Number" class="sapUiSmallMarginTop"/>
            <Input id="dsrInput" placeholder="Optional — required for anonymization"/>
          </VBox>
        </WizardStep>
        <WizardStep title="User History" id="step2">
          <VBox class="sapUiSmallMargin">
            <Button text="Search User" press=".onSearchUser" type="Emphasized" class="sapUiSmallMarginBottom"/>
            <Table id="historyTable" items="{history>/records}" noDataText="No records found">
              <columns>
                <Column><Text text="Date"/></Column>
                <Column><Text text="Type"/></Column>
                <Column><Text text="Title"/></Column>
                <Column><Text text="Status"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{history>completionDate}"/>
                    <Text text="{history>taskType}"/>
                    <Text text="{history>titleSnapshot}"/>
                    <Text text="{history>status}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </VBox>
        </WizardStep>
        <WizardStep title="Actions" id="step3">
          <VBox class="sapUiSmallMargin">
            <Button text="Download CSV" press=".onDownloadCsv" icon="sap-icon://download" class="sapUiSmallMarginEnd"/>
            <Button text="Anonymize User" press=".onAnonymize" type="Reject" icon="sap-icon://delete" class="sapUiSmallMarginTop"/>
          </VBox>
        </WizardStep>
      </Wizard>
    </content>
  </Page>
</mvc:View>
