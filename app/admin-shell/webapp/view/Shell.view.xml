<mvc:View
  controllerName="sap.tutorials.admin.shell.controller.Shell"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:tnt="sap.tnt"
  displayBlock="true">

  <tnt:ToolPage id="toolPage" sideExpanded="{viewModel>/sideExpanded}">

    <tnt:header>
      <tnt:ToolHeader>
        <Button
          id="navBackBtn"
          icon="sap-icon://nav-back"
          type="Transparent"
          press=".onNavBack"
          visible="{viewModel>/showBackButton}" />
        <Button
          id="sideNavToggleBtn"
          icon="sap-icon://menu2"
          type="Transparent"
          press=".onToggleSideNav" />
        <Title text="{viewModel>/headerTitle}" level="H5">
          <layoutData>
            <OverflowToolbarLayoutData priority="NeverOverflow" />
          </layoutData>
        </Title>
        <ToolbarSpacer />
        <SegmentedButton
          id="themeSwitch"
          selectedKey="{theme>/themeMode}"
          selectionChange=".onThemeChange">
          <items>
            <SegmentedButtonItem key="auto" icon="sap-icon://sys-monitor" tooltip="Auto (OS)" />
            <SegmentedButtonItem key="light" icon="sap-icon://lightbulb" tooltip="Light" />
            <SegmentedButtonItem key="dark" icon="sap-icon://dark-mode" tooltip="Dark" />
          </items>
        </SegmentedButton>
      </tnt:ToolHeader>
    </tnt:header>

    <tnt:sideContent>
      <tnt:SideNavigation id="sideNav" selectedKey="{nav>/selectedNavKey}" itemSelect=".onNavItemSelect">
        <tnt:NavigationList>
          <tnt:NavigationListItem text="Dashboard" icon="sap-icon://monitor-payments" key="dashboard" />
          <tnt:NavigationListItem text="Content" icon="sap-icon://folder-blank" expanded="true">
            <tnt:NavigationListItem text="Events" key="events" />
            <tnt:NavigationListItem text="Missions" key="missions" />
            <tnt:NavigationListItem text="Groups" key="groups" />
            <tnt:NavigationListItem text="Tutorials" key="tutorials" />
            <tnt:NavigationListItem text="Tags" key="tags" />
          </tnt:NavigationListItem>
          <tnt:NavigationListItem text="Rewards" icon="sap-icon://present" expanded="true">
            <tnt:NavigationListItem text="Accomplishments" key="accomplishments" />
            <tnt:NavigationListItem text="Prizes" key="prizes" />
          </tnt:NavigationListItem>
          <tnt:NavigationListItem text="System" icon="sap-icon://action-settings" expanded="true">
            <tnt:NavigationListItem text="Operations" key="operations" />
            <tnt:NavigationListItem text="Pipeline Log" key="pipelinelog" />
            <tnt:NavigationListItem text="Accounts" key="accounts" />
            <tnt:NavigationListItem text="Change Log" key="changelog" />
            <tnt:NavigationListItem text="Board" key="board" />
            <tnt:NavigationListItem text="Statistics" key="statistics" />
            <tnt:NavigationListItem text="Privacy" key="privacy" />
          </tnt:NavigationListItem>
        </tnt:NavigationList>
      </tnt:SideNavigation>
    </tnt:sideContent>

    <tnt:mainContents>
      <NavContainer id="contentArea" />
    </tnt:mainContents>

  </tnt:ToolPage>

</mvc:View>
