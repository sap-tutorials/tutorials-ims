<mvc:View
  controllerName="sap.tutorials.admin.shell.controller.Shell"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:tnt="sap.tnt"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <tnt:ToolPage id="toolPage" sideExpanded="{viewModel>/sideExpanded}">

    <tnt:header>
      <tnt:ToolHeader>
        <Button
          id="navBackBtn"
          icon="sap-icon://nav-back"
          type="Transparent"
          press=".onNavBack"
          visible="{viewModel>/showBackButton}" />
        <Button
          id="sideNavToggleBtn"
          icon="sap-icon://menu2"
          type="Transparent"
          press=".onToggleSideNav" />
        <Title text="{viewModel>/headerTitle}" level="H5">
          <layoutData>
            <OverflowToolbarLayoutData priority="NeverOverflow" />
          </layoutData>
        </Title>
        <ToolbarSpacer />
        <SegmentedButton
          id="themeSwitch"
          selectedKey="{theme>/themeMode}"
          selectionChange=".onThemeChange">
          <items>
            <SegmentedButtonItem key="auto" icon="sap-icon://sys-monitor" tooltip="Auto (OS)" />
            <SegmentedButtonItem key="light" icon="sap-icon://lightbulb" tooltip="Light" />
            <SegmentedButtonItem key="dark" icon="sap-icon://dark-mode" tooltip="Dark" />
          </items>
        </SegmentedButton>
        <ToolbarSeparator />
        <Button
          id="jouleBtn"
          icon="sap-icon://da"
          type="Transparent"
          tooltip="Joule"
          press=".onJoulePress" />
        <Button
          id="helpBtn"
          icon="sap-icon://sys-help"
          type="Transparent"
          tooltip="Help"
          press=".onHelpPress" />
        <Button
          id="notificationsBtn"
          icon="sap-icon://bell"
          type="Transparent"
          tooltip="Notifications"
          press=".onNotificationsPress" />
        <ToolbarSeparator />
        <Avatar
          id="userAvatar"
          displaySize="XS"
          displayShape="Circle"
          initials="{viewModel>/userInitials}"
          fallbackIcon="sap-icon://person-placeholder"
          backgroundColor="Accent6"
          press=".onAvatarPress" />
      </tnt:ToolHeader>
    </tnt:header>

    <tnt:sideContent>
      <tnt:SideNavigation id="sideNav" selectedKey="{nav>/selectedNavKey}" itemSelect=".onNavItemSelect">
        <tnt:NavigationList>
          <tnt:NavigationListItem text="Dashboard" icon="sap-icon://monitor-payments" key="dashboard" />
          <tnt:NavigationListItem text="Content" icon="sap-icon://folder-blank" expanded="true">
            <tnt:NavigationListItem text="Events" key="events" />
            <tnt:NavigationListItem text="Missions" key="missions" />
            <tnt:NavigationListItem text="Groups" key="groups" />
            <tnt:NavigationListItem text="Tutorials" key="tutorials" />
            <tnt:NavigationListItem text="Tags" key="tags" />
          </tnt:NavigationListItem>
          <tnt:NavigationListItem text="Rewards" icon="sap-icon://present" expanded="true">
            <tnt:NavigationListItem text="Accomplishments" key="accomplishments" />
            <tnt:NavigationListItem text="Prizes" key="prizes" />
          </tnt:NavigationListItem>
          <tnt:NavigationListItem text="System" icon="sap-icon://action-settings" expanded="true">
            <tnt:NavigationListItem text="Operations" key="operations" />
            <tnt:NavigationListItem text="Pipeline Log" key="pipelinelog" />
            <tnt:NavigationListItem text="Job Log" key="joblog" />
            <tnt:NavigationListItem text="Accounts" key="accounts" />
            <tnt:NavigationListItem text="Change Log" key="changelog" />
            <tnt:NavigationListItem text="Board" key="board" />
            <tnt:NavigationListItem text="Analytics" key="analytics" />
            <tnt:NavigationListItem text="Statistics" key="statistics" />
            <tnt:NavigationListItem text="Joule Chat" key="joule" />
            <tnt:NavigationListItem text="Privacy" key="privacy" />
          </tnt:NavigationListItem>
        </tnt:NavigationList>
      </tnt:SideNavigation>
    </tnt:sideContent>

    <tnt:mainContents>
      <NavContainer id="contentArea" />
    </tnt:mainContents>

    <tnt:dependents>
      <Popover
        id="userPopover"
        placement="Bottom"
        showHeader="true"
        title="{viewModel>/userName}">
        <VBox class="sapUiSmallMargin">
          <Avatar
            displaySize="L"
            displayShape="Circle"
            initials="{viewModel>/userInitials}"
            fallbackIcon="sap-icon://person-placeholder"
            backgroundColor="Accent6"
            class="sapUiSmallMarginBottom" />
          <Label text="{viewModel>/userName}" design="Bold" />
          <Label text="{viewModel>/userEmail}" class="sapUiSmallMarginBottom" />
          <Link text="Manage my Account" href="https://account.sap.com" target="_blank" />
          <Link text="SAP Community" href="https://community.sap.com" target="_blank" />
          <Link text="SAP Developers" href="https://www.youtube.com/@sapdevs" target="_blank" />
          <Link text="Learnings" href="https://learning.sap.com" target="_blank" class="sapUiTinyMarginBottom" />
          <Button text="Logout" type="Reject" press=".onLogout" class="sapUiSmallMarginTop" />
        </VBox>
      </Popover>
      <Popover
        id="notificationsPopover"
        placement="Bottom"
        title="Notifications">
        <VBox class="sapUiSmallMargin">
          <Label text="No new notifications" class="sapUiSmallMargin" />
        </VBox>
      </Popover>
    </tnt:dependents>

  </tnt:ToolPage>

</mvc:View>
