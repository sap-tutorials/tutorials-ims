<mvc:View
  controllerName="sap.tutorials.admin.shell.controller.Shell"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:tnt="sap.tnt"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <tnt:ToolPage id="toolPage" sideExpanded="{viewModel>/sideExpanded}">

    <tnt:header>
      <tnt:ToolHeader>
        <Button
          id="navBackBtn"
          icon="sap-icon://nav-back"
          type="Transparent"
          press=".onNavBack"
          visible="{viewModel>/showBackButton}" />
        <Button
          id="sideNavToggleBtn"
          icon="sap-icon://menu2"
          type="Transparent"
          press=".onToggleSideNav" />
        <Title text="{viewModel>/consoleTitle}" level="H5">
          <layoutData>
            <OverflowToolbarLayoutData priority="NeverOverflow" />
          </layoutData>
        </Title>
        <ToolbarSpacer />
        <SegmentedButton
          id="themeSwitch"
          selectedKey="{theme>/themeMode}"
          selectionChange=".onThemeChange">
          <items>
            <SegmentedButtonItem key="auto" icon="sap-icon://sys-monitor" tooltip="Auto (OS)" />
            <SegmentedButtonItem key="light" icon="sap-icon://lightbulb" tooltip="Light" />
            <SegmentedButtonItem key="dark" icon="sap-icon://dark-mode" tooltip="Dark" />
          </items>
        </SegmentedButton>
        <ToolbarSeparator />
        <Button
          id="jouleBtn"
          icon="sap-icon://da"
          type="Transparent"
          tooltip="Joule"
          press=".onJoulePress" />
        <Button
          id="helpBtn"
          icon="sap-icon://sys-help"
          type="Transparent"
          tooltip="Help"
          press=".onHelpPress" />
        <Button
          id="notificationsBtn"
          icon="sap-icon://bell"
          type="Transparent"
          tooltip="Notifications"
          press=".onNotificationsPress" />
        <ToolbarSeparator />
        <Avatar
          id="userAvatar"
          displaySize="XS"
          displayShape="Circle"
          initials="{viewModel>/userInitials}"
          fallbackIcon="sap-icon://person-placeholder"
          backgroundColor="Accent6"
          press=".onAvatarPress" />
      </tnt:ToolHeader>
    </tnt:header>

    <tnt:sideContent>
      <tnt:SideNavigation id="sideNav" selectedKey="{nav>/selectedNavKey}" itemSelect=".onNavItemSelect">
        <tnt:NavigationList items="{nav>/groups}">
          <tnt:NavigationListItem
              text="{nav>title}"
              icon="{nav>icon}"
              key="{nav>key}"
              href="{nav>href}"
              target="{nav>target}"
              items="{nav>items}"
              expanded="{nav>expanded}">
            <tnt:NavigationListItem
                text="{nav>title}"
                key="{nav>key}"
                icon="{nav>icon}"
                href="{nav>href}"
                target="{nav>target}" />
          </tnt:NavigationListItem>
        </tnt:NavigationList>
      </tnt:SideNavigation>
    </tnt:sideContent>

    <tnt:mainContents>
      <NavContainer id="contentArea" />
    </tnt:mainContents>

    <tnt:dependents>
      <Popover
        id="userPopover"
        placement="Bottom"
        showHeader="true"
        title="{viewModel>/userName}">
        <VBox class="sapUiSmallMargin">
          <Avatar
            displaySize="L"
            displayShape="Circle"
            initials="{viewModel>/userInitials}"
            fallbackIcon="sap-icon://person-placeholder"
            backgroundColor="Accent6"
            class="sapUiSmallMarginBottom" />
          <Label text="{viewModel>/userName}" design="Bold" />
          <Label text="{viewModel>/userEmail}" class="sapUiSmallMarginBottom" />
          <Link text="Manage my Account" href="https://account.sap.com" target="_blank" />
          <Link text="SAP Community" href="https://community.sap.com" target="_blank" />
          <Link text="SAP Developers" href="https://www.youtube.com/@sapdevs" target="_blank" />
          <Link text="Learnings" href="https://learning.sap.com" target="_blank" class="sapUiTinyMarginBottom" />
          <Button text="Logout" type="Reject" press=".onLogout" class="sapUiSmallMarginTop" />
        </VBox>
      </Popover>
      <Popover
        id="notificationsPopover"
        placement="Bottom"
        title="Notifications"
        contentWidth="380px">
        <VBox class="sapUiSmallMargin">
          <List
            id="notificationsList"
            items="{notifications>/items}"
            noDataText="{i18n>notificationsEmpty}"
            showSeparators="Inner">
            <CustomListItem>
              <VBox class="sapUiSmallMargin">
                <ObjectStatus
                  text="{notifications>key}"
                  state="{notifications>uiState}"
                  icon="{notifications>uiIcon}" />
                <Text text="{notifications>summary}" class="sapUiTinyMarginTop" />
                <HBox class="sapUiTinyMarginTop">
                  <Link
                    text="Rotation guide"
                    href="{notifications>rotationDocsUrl}"
                    target="_blank"
                    visible="{= !!${notifications>rotationDocsUrl} }" />
                  <ToolbarSpacer />
                  <Text text="{notifications>rotationOwner}" class="sapUiTinyMarginBegin" />
                </HBox>
              </VBox>
            </CustomListItem>
          </List>
        </VBox>
      </Popover>
    </tnt:dependents>

  </tnt:ToolPage>

</mvc:View>
