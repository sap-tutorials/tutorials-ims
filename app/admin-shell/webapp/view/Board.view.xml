<mvc:View
  controllerName="sap.tutorials.admin.shell.controller.Board"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:core="sap.ui.core"
  xmlns:suite="sap.suite.ui.microchart">
  <Page title="Board" enableScrolling="true">
    <content>
      <l:Grid defaultSpan="L3 M4 S6" class="sapUiSmallMargin" width="100%">

        <GenericTile header="Users" subheader="Total registered">
          <TileContent>
            <NumericContent value="{board>/totalUsers}" />
          </TileContent>
        </GenericTile>

        <GenericTile header="Tutorials" subheader="Total content">
          <TileContent>
            <NumericContent value="{board>/totalTutorials}" />
          </TileContent>
        </GenericTile>

        <GenericTile header="Groups" subheader="Learning groups">
          <TileContent>
            <NumericContent value="{board>/totalGroups}" />
          </TileContent>
        </GenericTile>

        <GenericTile header="Missions" subheader="Learning missions">
          <TileContent>
            <NumericContent value="{board>/totalMissions}" />
          </TileContent>
        </GenericTile>

        <GenericTile header="Avg Tutorial %" subheader="Completion rate">
          <TileContent>
            <NumericContent value="{board>/avgTutorialCompletion}" scale="%" valueColor="Good" />
          </TileContent>
        </GenericTile>

        <GenericTile header="Avg Group %" subheader="Completion rate">
          <TileContent>
            <NumericContent value="{board>/avgGroupCompletion}" scale="%" valueColor="Good" />
          </TileContent>
        </GenericTile>

        <GenericTile header="Avg Mission %" subheader="Completion rate">
          <TileContent>
            <NumericContent value="{board>/avgMissionCompletion}" scale="%" valueColor="Good" />
          </TileContent>
        </GenericTile>

        <GenericTile header="Up to Date" subheader="Reviewed &lt; 6 months">
          <TileContent>
            <NumericContent value="{board>/tutorialsUpToDate}" valueColor="Good" />
          </TileContent>
        </GenericTile>

        <GenericTile header="Needs Review" subheader="Outdated &gt; 6 months">
          <TileContent>
            <NumericContent value="{board>/tutorialsNeedReview}" valueColor="Critical" />
          </TileContent>
        </GenericTile>

        <GenericTile header="Review Status" subheader="Up to date vs outdated">
          <TileContent>
            <suite:RadialMicroChart
              percentage="{board>/reviewPercentage}"
              valueColor="{= ${board>/reviewPercentage} >= 70 ? 'Good' : ${board>/reviewPercentage} >= 40 ? 'Critical' : 'Error'}" />
          </TileContent>
        </GenericTile>

      </l:Grid>

      <!-- #756: Cron health tile extended from the Phase 4.5 (#746) baseline.
           Schedule + Next run columns sourced from AdminService.JobControls.listJobs(),
           Last success + Last error sourced from AdminService.JobLastRun.
           #1023: Status column reflects live PipelineLog RUNNING state via
           AdminService.JobControls.listRunningJobs(), classified by the
           job-controls-helpers.classifyJobStatus formatter.
           Controller does the JOIN client-side into a JSONModel at
           jobControls>/jobs; the Run now button invokes runJob(jobName) and
           optimistically flips isRunning for the busy spinner. -->
      <Panel headerText="Cron health" expandable="true" expanded="true" class="sapUiSmallMargin"
             expand=".onCronPanelExpand">
        <!-- #750: 24-hour SVG timeline ribbon. Built client-side in
             Board.controller.js _loadJobControls() via CronTimelineHelpers.
             sanitizeContent="false" because the SVG is hand-emitted by our
             own pure helper (no untrusted content). -->
        <core:HTML content="{jobControls>/timelineHtml}" sanitizeContent="false" />
        <Table id="cronHealthTable" items="{jobControls>/jobs}" growing="true" growingThreshold="40">
          <columns>
            <Column><Text text="Job" /></Column>
            <!-- #1023: RUNNING / OK / FAILED / STALE / NEVER categorical. -->
            <Column><Text text="Status" /></Column>
            <Column><Text text="Schedule" /></Column>
            <Column><Text text="Next run" /></Column>
            <!-- #750: forward-visibility column. Renders the first 3 entries
                 of nextRunsIso stacked vertically; missing slots render as
                 empty strings (no layout shift). -->
            <Column><Text text="Next 3 runs" /></Column>
            <Column><Text text="Last success" /></Column>
            <Column><Text text="Last error" /></Column>
            <Column hAlign="End"><Text text="Trigger" /></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{jobControls>jobName}" tooltip="{jobControls>description}" />
                <!-- #1023: ObjectStatus renders coloured pill; tooltip shows
                     elapsed time when RUNNING, otherwise blank. -->
                <ObjectStatus text="{jobControls>statusLabel}"
                              state="{jobControls>statusState}"
                              tooltip="{path: 'jobControls>runningSince', formatter: '.formatElapsedSince'}" />
                <Text text="{jobControls>schedule}" class="kg-mono" />
                <Text text="{path: 'jobControls>nextRunIso', formatter: '.formatNextRun'}" />
                <!-- #750: three stacked relative-time lines. Missing slots render
                     empty (no layout shift). Formatter handles undefined safely. -->
                <VBox>
                  <Text text="{path: 'jobControls>nextRunsIso/0', formatter: '.formatNextRun'}" />
                  <Text text="{path: 'jobControls>nextRunsIso/1', formatter: '.formatNextRun'}" />
                  <Text text="{path: 'jobControls>nextRunsIso/2', formatter: '.formatNextRun'}" />
                </VBox>
                <Text text="{path: 'jobControls>lastSuccessAt', formatter: '.formatRelativeTime'}" />
                <Text text="{jobControls>lastErrorMessage}" tooltip="{jobControls>lastErrorMessage}" />
                <Button text="Run now" type="Emphasized" press=".onRunJob"
                        busy="{jobControls>isRunning}" busyIndicatorDelay="0" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>
    </content>
  </Page>
</mvc:View>
