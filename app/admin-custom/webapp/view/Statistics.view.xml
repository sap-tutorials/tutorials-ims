<mvc:View
  controllerName="sap.tutorials.admin.custom.controller.Statistics"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form">
  <Page title="{i18n>statisticsTitle}">
    <content>
      <f:SimpleForm editable="true" layout="ResponsiveGridLayout" class="sapUiSmallMargin">
        <f:toolbar>
          <Toolbar><Title text="Export Parameters"/></Toolbar>
        </f:toolbar>
        <Label text="Event Legacy ID"/>
        <Input id="eventIdInput" type="Number" placeholder="Enter Event ID"/>
        <Label text="Format"/>
        <Select id="formatSelect">
          <items>
            <core:Item xmlns:core="sap.ui.core" key="csv" text="CSV"/>
            <core:Item xmlns:core="sap.ui.core" key="json" text="JSON"/>
          </items>
        </Select>
      </f:SimpleForm>
      <HBox class="sapUiSmallMargin">
        <Button text="Export Task Records" press=".onExportTaskRecords" type="Emphasized" class="sapUiTinyMarginEnd"/>
        <Button text="Export Award Missions" press=".onExportAwardMissions"/>
      </HBox>
    </content>
  </Page>
</mvc:View>
