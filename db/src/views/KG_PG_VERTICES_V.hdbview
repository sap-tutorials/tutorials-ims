VIEW "KG_PG_VERTICES_V" AS
  -- Concept vertices — exactly ONE row per active concept slug.
  --
  -- NVARCHAR(280) sizing: Tutorials.slug is String(255) per db/schema.cds;
  -- Concepts.slug is String(80). 'tutorial:' + 255 = 264; 280 gives modest
  -- headroom. HANA does NOT silently truncate CAST — a longer slug would
  -- raise a data-exception at query time. Keeping this sizing in sync with
  -- the equivalent CAST in KG_PG_EDGES_V.hdbview is what prevents workspace
  -- load-time key-mismatch errors.
  --
  -- ROW_NUMBER dedupe (KG vertex-dup bug): Concepts.slug carries
  -- @assert.unique in db/knowledge-graph.cds, but that is a CAP RUNTIME
  -- check only — the deployed HANA table has ONLY a PRIMARY KEY on ID
  -- (UUID), NO unique index on SLUG (a partial UNIQUE(slug) WHERE
  -- status='ACTIVE' can't be expressed in HDI artifacts). Every KG writer
  -- goes through raw db.run() and bypasses the service layer, so a mint
  -- race (see srv/lib/kg-merge-on-write.js) can leave TWO ACTIVE rows with
  -- the same slug. Without dedupe this arm then emits 'concept:<slug>'
  -- twice, and the graph engine rejects the whole workspace at
  -- KG_LOUVAIN_GRAPH runtime with [4907] range 1 — crashing all three KG
  -- jobs (kg-pagerank, kg-communities/Louvain, kg-wcc). A bare DISTINCT is
  -- NOT enough: the arm selects NAME as LABEL, so two rows differing only in
  -- NAME would still both survive DISTINCT and re-introduce the dup key.
  -- ROW_NUMBER() OVER (PARTITION BY SLUG ...) keeps exactly one row per
  -- slug, deterministically (most-recently-modified wins; ID breaks ties).
  -- HANA has no QUALIFY clause, so the window filter lives in a derived
  -- table. Layer B (srv/lib/kg-merge-on-write.js) stops the dup at the
  -- source; this arm is the defense-in-depth that keeps the jobs alive even
  -- if bad data drifts back in.
  SELECT
    "VERTEX_KEY",
    "VERTEX_TYPE",
    "SLUG",
    "LABEL",
    "STATUS"
  FROM (
    SELECT
      CAST('concept:' || SLUG AS NVARCHAR(280)) AS "VERTEX_KEY",
      'concept'                                 AS "VERTEX_TYPE",
      SLUG                                      AS "SLUG",
      NAME                                      AS "LABEL",
      STATUS                                    AS "STATUS",
      ROW_NUMBER() OVER (
        PARTITION BY SLUG ORDER BY MODIFIEDAT DESC, ID
      )                                         AS "RN"
    FROM "COM_SAP_DEVELOPERS_IMS_CONCEPTS"
    WHERE STATUS = 'ACTIVE'
  )
  WHERE "RN" = 1
  UNION ALL
  -- Tutorial vertices — one row per Tutorials row.
  --
  -- Prior to this fix the arm SELECTed FROM TutorialConceptLinks JOIN
  -- Tutorials, on the assumption that "tutorials without concept links
  -- don't matter to the graph." That was wrong once the edge view grew
  -- beyond the 2-predicate spike:
  --
  --   taggedWith / aboutProduct : TutorialTags → Tutorials
  --   partOf tutorial→mission   : CompletionPathItems → Tutorials
  --   coCompletedWith           : CoCompletions.SOURCESLUG / .TARGETSLUG
  --   extends (target side)     : tcl.EXTENDSTUTORIAL_ID (unlinked target)
  --
  -- A tutorial can appear as an edge endpoint via any of these arms WITHOUT
  -- having a TutorialConceptLinks row. When that happens the graph engine's
  -- workspace validator rejects the whole workspace at KG_LOUVAIN_GRAPH
  -- runtime with error [4907] range 3:
  --   "Source or target column contains an invalid vertex key
  --    'tutorial:<slug>'"
  -- (Distinct from range 1's EDGE_KEY dup/NULL check that #1020 fixed —
  -- same error code, different subcondition.) Diagnosed against DEV: e.g.
  -- 'cp-sdk-android-flows-stores' has 0 TutorialConceptLinks rows but 4
  -- taggedWith edges.
  --
  -- Fix: emit one vertex per Tutorials row directly. Tutorials.slug is
  -- @assert.unique.slug so DISTINCT is unnecessary. Mirrors the missions
  -- and groups arms below, added in #919 for the same reason.
  SELECT
    CAST('tutorial:' || SLUG AS NVARCHAR(280)) AS "VERTEX_KEY",
    'tutorial'                                 AS "VERTEX_TYPE",
    SLUG                                       AS "SLUG",
    TITLE                                      AS "LABEL",
    NULL                                       AS "STATUS"
  FROM "COM_SAP_DEVELOPERS_IMS_TUTORIALS"
  WHERE SLUG IS NOT NULL
  UNION ALL
  -- Mission vertices. Missions have a STATUS column ('ACTIVE' /
  -- 'DELETED') — use it directly. #919 added missions to support the
  -- partOf and inCategory edge arms.
  SELECT
    CAST('mission:' || SLUG AS NVARCHAR(280)) AS "VERTEX_KEY",
    'mission'                                 AS "VERTEX_TYPE",
    SLUG                                      AS "SLUG",
    TITLE                                     AS "LABEL",
    STATUS                                    AS "STATUS"
  FROM "COM_SAP_DEVELOPERS_IMS_MISSIONS"
  WHERE SLUG IS NOT NULL
  UNION ALL
  -- Group vertices. #919 added groups to support the partOf arm's
  -- mission→group hop.
  SELECT
    CAST('group:' || SLUG AS NVARCHAR(280)) AS "VERTEX_KEY",
    'group'                                 AS "VERTEX_TYPE",
    SLUG                                    AS "SLUG",
    TITLE                                   AS "LABEL",
    STATUS                                  AS "STATUS"
  FROM "COM_SAP_DEVELOPERS_IMS_GROUPS"
  WHERE SLUG IS NOT NULL
  UNION ALL
  -- Tag vertices. Tags have no dedicated slug column — RDF projection
  -- and the taggedWith edge arm both use NAME as the identifier.
  --
  -- ROW_NUMBER dedupe (NOT DISTINCT): Tags.name has no @assert.unique and
  -- the deployed HANA table has NO unique index on NAME, so the same NAME
  -- can appear on multiple rows (13 such names on PROD as of 2026-09-24:
  -- 'sapui5' x3, 'sap gateway' x2, ...). A bare DISTINCT is NOT enough
  -- because this arm also selects LABEL: two rows sharing NAME but differing
  -- in LABEL both survive DISTINCT and re-emit 'tag:<name>' twice — exactly
  -- the trap the concept arm's header warns about. That happened in PROD
  -- ('sustainability for human capital management' had two rows whose LABEL
  -- differed only by a double space), producing a duplicate VERTEX_KEY and
  -- crashing all three KG jobs (pagerank, communities/Louvain, wcc) at
  -- KG_LOUVAIN_GRAPH runtime with [4907] range 1. The taggedWith edge arm
  -- keys the tag endpoint on NAME alone, so emitting exactly one vertex per
  -- NAME (any surviving LABEL) keeps edge targets resolvable. Tags has no
  -- MODIFIEDAT column — order by LEGACYID (ID breaks ties) for determinism.
  SELECT
    "VERTEX_KEY",
    "VERTEX_TYPE",
    "SLUG",
    "LABEL",
    "STATUS"
  FROM (
    SELECT
      CAST('tag:' || NAME AS NVARCHAR(280)) AS "VERTEX_KEY",
      'tag'                                 AS "VERTEX_TYPE",
      NAME                                  AS "SLUG",
      LABEL                                 AS "LABEL",
      'ACTIVE'                              AS "STATUS",
      ROW_NUMBER() OVER (
        PARTITION BY NAME ORDER BY LEGACYID DESC, ID
      )                                     AS "RN"
    FROM "COM_SAP_DEVELOPERS_IMS_TAGS"
    WHERE NAME IS NOT NULL
  )
  WHERE "RN" = 1
  UNION ALL
  -- Product vertices — synthesized from tags whose NAME starts with
  -- 'software-product>'. LENGTH('software-product>')=17, so
  -- SUBSTRING(NAME, 18) extracts the suffix as the product slug.
  -- Mirrors RDF projection at srv/lib/kg-projection.js:305-310.
  --
  -- ROW_NUMBER dedupe (NOT DISTINCT), for the same reason as the tag arm
  -- above: multiple tag rows can extract to the same product suffix, and
  -- because this arm selects LABEL a bare DISTINCT would let two rows that
  -- differ only in LABEL both survive and re-emit 'product:<suffix>' twice,
  -- crashing the KG jobs at KG_LOUVAIN_GRAPH runtime ([4907] range 1). No
  -- product-suffix dup with a differing label exists on PROD today, but the
  -- flawed pattern is one label edit away from the crash the tag arm hit —
  -- this makes it defense-in-depth like every other keyed arm. Order by
  -- LEGACYID DESC, ID for determinism (Tags has no MODIFIEDAT).
  SELECT
    "VERTEX_KEY",
    "VERTEX_TYPE",
    "SLUG",
    "LABEL",
    "STATUS"
  FROM (
    SELECT
      CAST('product:' || SUBSTRING(NAME, 18) AS NVARCHAR(280)) AS "VERTEX_KEY",
      'product'                                                AS "VERTEX_TYPE",
      SUBSTRING(NAME, 18)                                      AS "SLUG",
      LABEL                                                    AS "LABEL",
      'ACTIVE'                                                 AS "STATUS",
      ROW_NUMBER() OVER (
        PARTITION BY SUBSTRING(NAME, 18) ORDER BY LEGACYID DESC, ID
      )                                                        AS "RN"
    FROM "COM_SAP_DEVELOPERS_IMS_TAGS"
    WHERE NAME LIKE 'software-product>%'
  )
  WHERE "RN" = 1
  UNION ALL
  -- Category vertices. Categories are CSV-seeded (8 rows) with slugs
  -- that are @mandatory at the CDS layer — the NULL filter is
  -- defense-in-depth since HANA doesn't enforce @mandatory on
  -- CSV-seeded rows.
  SELECT
    CAST('category:' || SLUG AS NVARCHAR(280)) AS "VERTEX_KEY",
    'category'                                 AS "VERTEX_TYPE",
    SLUG                                       AS "SLUG",
    LABEL                                      AS "LABEL",
    'ACTIVE'                                   AS "STATUS"
  FROM "COM_SAP_DEVELOPERS_IMS_CATEGORIES"
  WHERE SLUG IS NOT NULL
  UNION ALL
  -- TechEd session vertices (#2312). One row per TechEdSessions row, keyed on
  -- SLUG. TechEdSessions.slug carries @assert.unique in db/external/teched.cds,
  -- but that is a CAP RUNTIME check only — the delta-ingest seed
  -- (srv/lib/teched/seed-core.js) writes via raw db.run() SELECT-then-UPSERT
  -- keyed on sourceId (NOT slug) and bypasses the service layer, so it cannot
  -- enforce @assert.unique. The deployed HANA table has ONLY a PRIMARY KEY on
  -- ID (UUID), NO unique index on SLUG. A sourceId-churn / re-slug race could
  -- therefore leave two rows sharing a SLUG, which would emit
  -- 'teched_session:<slug>' twice and crash all three KG jobs at
  -- KG_LOUVAIN_GRAPH runtime with [4907] range 1. Same ROW_NUMBER dedup guard
  -- as the concept arm above keeps exactly one row per slug (most-recently-
  -- modified wins; ID breaks ties). Defense-in-depth, mirroring the concept arm.
  SELECT
    "VERTEX_KEY",
    "VERTEX_TYPE",
    "SLUG",
    "LABEL",
    "STATUS"
  FROM (
    SELECT
      CAST('teched_session:' || SLUG AS NVARCHAR(280)) AS "VERTEX_KEY",
      'teched_session'                                 AS "VERTEX_TYPE",
      SLUG                                             AS "SLUG",
      TITLE                                            AS "LABEL",
      'ACTIVE'                                         AS "STATUS",
      ROW_NUMBER() OVER (
        PARTITION BY SLUG ORDER BY MODIFIEDAT DESC, ID
      )                                                AS "RN"
    FROM "COM_SAP_DEVELOPERS_IMS_EXTERNAL_TECHEDSESSIONS"
    WHERE SLUG IS NOT NULL
  )
  WHERE "RN" = 1
  UNION ALL
  -- TechEd track vertices (#2312). Added to back the session→track 'inTrack'
  -- edge arm in KG_PG_EDGES_V — mirrors how #919 added mission/group vertices
  -- specifically to satisfy the workspace validator for their edge arms
  -- (an edge TARGET with no matching VERTEX_KEY is rejected at
  -- KG_LOUVAIN_GRAPH runtime with [4907] range 3). Same raw-write /
  -- runtime-only-@assert.unique dedup rationale as the teched_session arm.
  SELECT
    "VERTEX_KEY",
    "VERTEX_TYPE",
    "SLUG",
    "LABEL",
    "STATUS"
  FROM (
    SELECT
      CAST('teched_track:' || SLUG AS NVARCHAR(280)) AS "VERTEX_KEY",
      'teched_track'                                 AS "VERTEX_TYPE",
      SLUG                                           AS "SLUG",
      NAME                                           AS "LABEL",
      'ACTIVE'                                       AS "STATUS",
      ROW_NUMBER() OVER (
        PARTITION BY SLUG ORDER BY MODIFIEDAT DESC, ID
      )                                              AS "RN"
    FROM "COM_SAP_DEVELOPERS_IMS_EXTERNAL_TECHEDTRACKS"
    WHERE SLUG IS NOT NULL
  )
  WHERE "RN" = 1
  UNION ALL
  -- TechEd speaker vertices (#2312). Added to back the session→speaker
  -- 'presentedBy' edge arm. Same dedup rationale as the teched_session arm.
  SELECT
    "VERTEX_KEY",
    "VERTEX_TYPE",
    "SLUG",
    "LABEL",
    "STATUS"
  FROM (
    SELECT
      CAST('teched_speaker:' || SLUG AS NVARCHAR(280)) AS "VERTEX_KEY",
      'teched_speaker'                                 AS "VERTEX_TYPE",
      SLUG                                             AS "SLUG",
      NAME                                             AS "LABEL",
      'ACTIVE'                                         AS "STATUS",
      ROW_NUMBER() OVER (
        PARTITION BY SLUG ORDER BY MODIFIEDAT DESC, ID
      )                                                AS "RN"
    FROM "COM_SAP_DEVELOPERS_IMS_EXTERNAL_TECHEDSPEAKERS"
    WHERE SLUG IS NOT NULL
  )
  WHERE "RN" = 1;
