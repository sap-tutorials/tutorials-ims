VIEW "KG_PG_VERTICES_V" AS
  -- Concept vertices — one row per active concept.
  --
  -- NVARCHAR(280) sizing: Tutorials.slug is String(255) per db/schema.cds;
  -- Concepts.slug is String(80). 'tutorial:' + 255 = 264; 280 gives modest
  -- headroom. HANA does NOT silently truncate CAST — a longer slug would
  -- raise a data-exception at query time. Keeping this sizing in sync with
  -- the equivalent CAST in KG_PG_EDGES_V.hdbview is what prevents workspace
  -- load-time key-mismatch errors.
  SELECT
    CAST('concept:' || SLUG AS NVARCHAR(280)) AS "VERTEX_KEY",
    'concept'                                 AS "VERTEX_TYPE",
    SLUG                                      AS "SLUG",
    NAME                                      AS "LABEL",
    STATUS                                    AS "STATUS"
  FROM "COM_SAP_DEVELOPERS_IMS_CONCEPTS"
  WHERE STATUS = 'ACTIVE'
  UNION ALL
  -- Tutorial vertices — one row per Tutorials row.
  --
  -- Prior to this fix the arm SELECTed FROM TutorialConceptLinks JOIN
  -- Tutorials, on the assumption that "tutorials without concept links
  -- don't matter to the graph." That was wrong once the edge view grew
  -- beyond the 2-predicate spike:
  --
  --   taggedWith / aboutProduct : TutorialTags → Tutorials
  --   partOf tutorial→mission   : CompletionPathItems → Tutorials
  --   coCompletedWith           : CoCompletions.SOURCESLUG / .TARGETSLUG
  --   extends (target side)     : tcl.EXTENDSTUTORIAL_ID (unlinked target)
  --
  -- A tutorial can appear as an edge endpoint via any of these arms WITHOUT
  -- having a TutorialConceptLinks row. When that happens the graph engine's
  -- workspace validator rejects the whole workspace at KG_LOUVAIN_GRAPH
  -- runtime with error [4907] range 3:
  --   "Source or target column contains an invalid vertex key
  --    'tutorial:<slug>'"
  -- (Distinct from range 1's EDGE_KEY dup/NULL check that #1020 fixed —
  -- same error code, different subcondition.) Diagnosed against DEV: e.g.
  -- 'cp-sdk-android-flows-stores' has 0 TutorialConceptLinks rows but 4
  -- taggedWith edges.
  --
  -- Fix: emit one vertex per Tutorials row directly. Tutorials.slug is
  -- @assert.unique.slug so DISTINCT is unnecessary. Mirrors the missions
  -- and groups arms below, added in #919 for the same reason.
  SELECT
    CAST('tutorial:' || SLUG AS NVARCHAR(280)) AS "VERTEX_KEY",
    'tutorial'                                 AS "VERTEX_TYPE",
    SLUG                                       AS "SLUG",
    TITLE                                      AS "LABEL",
    NULL                                       AS "STATUS"
  FROM "COM_SAP_DEVELOPERS_IMS_TUTORIALS"
  WHERE SLUG IS NOT NULL
  UNION ALL
  -- Mission vertices. Missions have a STATUS column ('ACTIVE' /
  -- 'DELETED') — use it directly. #919 added missions to support the
  -- partOf and inCategory edge arms.
  SELECT
    CAST('mission:' || SLUG AS NVARCHAR(280)) AS "VERTEX_KEY",
    'mission'                                 AS "VERTEX_TYPE",
    SLUG                                      AS "SLUG",
    TITLE                                     AS "LABEL",
    STATUS                                    AS "STATUS"
  FROM "COM_SAP_DEVELOPERS_IMS_MISSIONS"
  WHERE SLUG IS NOT NULL
  UNION ALL
  -- Group vertices. #919 added groups to support the partOf arm's
  -- mission→group hop.
  SELECT
    CAST('group:' || SLUG AS NVARCHAR(280)) AS "VERTEX_KEY",
    'group'                                 AS "VERTEX_TYPE",
    SLUG                                    AS "SLUG",
    TITLE                                   AS "LABEL",
    STATUS                                  AS "STATUS"
  FROM "COM_SAP_DEVELOPERS_IMS_GROUPS"
  WHERE SLUG IS NOT NULL
  UNION ALL
  -- Tag vertices. Tags have no dedicated slug column — RDF projection
  -- and the taggedWith edge arm both use NAME as the identifier.
  -- DISTINCT because Tags.name has no @assert.unique (dup-name risk
  -- RDF already lives with; defense-in-depth here).
  SELECT DISTINCT
    CAST('tag:' || NAME AS NVARCHAR(280)) AS "VERTEX_KEY",
    'tag'                                 AS "VERTEX_TYPE",
    NAME                                  AS "SLUG",
    LABEL                                 AS "LABEL",
    'ACTIVE'                              AS "STATUS"
  FROM "COM_SAP_DEVELOPERS_IMS_TAGS"
  WHERE NAME IS NOT NULL
  UNION ALL
  -- Product vertices — synthesized from tags whose NAME starts with
  -- 'software-product>'. LENGTH('software-product>')=17, so
  -- SUBSTRING(NAME, 18) extracts the suffix as the product slug.
  -- DISTINCT because multiple tag rows may extract to the same product
  -- slug. Mirrors RDF projection at srv/lib/kg-projection.js:305-310.
  SELECT DISTINCT
    CAST('product:' || SUBSTRING(NAME, 18) AS NVARCHAR(280)) AS "VERTEX_KEY",
    'product'                                                AS "VERTEX_TYPE",
    SUBSTRING(NAME, 18)                                      AS "SLUG",
    LABEL                                                    AS "LABEL",
    'ACTIVE'                                                 AS "STATUS"
  FROM "COM_SAP_DEVELOPERS_IMS_TAGS"
  WHERE NAME LIKE 'software-product>%'
  UNION ALL
  -- Category vertices. Categories are CSV-seeded (8 rows) with slugs
  -- that are @mandatory at the CDS layer — the NULL filter is
  -- defense-in-depth since HANA doesn't enforce @mandatory on
  -- CSV-seeded rows.
  SELECT
    CAST('category:' || SLUG AS NVARCHAR(280)) AS "VERTEX_KEY",
    'category'                                 AS "VERTEX_TYPE",
    SLUG                                       AS "SLUG",
    LABEL                                      AS "LABEL",
    'ACTIVE'                                   AS "STATUS"
  FROM "COM_SAP_DEVELOPERS_IMS_CATEGORIES"
  WHERE SLUG IS NOT NULL;
