{
    "tutorials-kg-grantor": {
        "application_user": {
            "system_privileges": [
                {
                    "privileges": [
                        "SPARQL QUERY",
                        "SPARQL UPDATE"
                    ]
                }
            ]
        },
        "object_owner": {
            "system_privileges": [
                {
                    "privileges": [
                        "SPARQL QUERY",
                        "SPARQL UPDATE"
                    ]
                }
            ],
            "global_object_privileges": [
                {
                    "name": "TUTORIALS_AICORE",
                    "type": "REMOTE SOURCE",
                    "privileges": [
                        "EXECUTE"
                    ]
                }
            ]
        }
    }
}
