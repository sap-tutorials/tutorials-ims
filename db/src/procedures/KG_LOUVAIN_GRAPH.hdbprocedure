-- KG_LOUVAIN_GRAPH.hdbprocedure
-- ============================================================
-- HANA GraphScript community detection over KG_PG_WORKSPACE. Calls the
-- built-in Communities_Louvain primitive and returns one row per vertex
-- tagged with its community id, VERTEX_KEY, VERTEX_TYPE, and SLUG so
-- the caller (srv/jobs/kg-communities-job.js) doesn't have to re-join
-- back to KG_PG_VERTICES_V.
--
-- WHY A SEPARATE PROCEDURE
--   HANA SQLScript does NOT allow inline `LANGUAGE GRAPH` blocks inside
--   a `LANGUAGE SQLSCRIPT` procedure body. GraphScript is a distinct
--   language that must be declared at the procedure boundary. Same
--   pattern as sibling KG_SHORTEST_PATH_GRAPH.
--
-- SYNTAX REFERENCE
--   Modeled after SAP's official HANA Cloud Communities_Louvain sample:
--   https://github.com/SAP-samples/hana-graph-examples/blob/main/
--     GRAPH_PROCEDURE_EXAMPLES/BUILTIN_FUNCTIONS_ALGORITHMS/
--     HANA_Cloud_2023Q2_Communities_Louvain.sql
--   Key patterns from that sample:
--     - Return type is `SEQUENCE<MULTISET<VERTEX>>` (an ordered
--       collection of vertex groupings — NOT a MULTISET<INTEGER> of
--       community ids). Prior deploy attempt (see stub commit
--       ceafd190 rationale) used the wrong return type and a
--       SQL-style JOIN, both of which fail GraphScript parse.
--     - `TO_ORDINALITY_MAP(:communities)` converts the sequence into
--       a MAP<VERTEX, BIGINT> keyed by vertex, valued by community
--       ordinal — exactly the shape we want to emit.
--     - `SELECT :v."ID", :m[:v] FOREACH v IN Vertices(:g)` — this is
--       the correct emit-per-vertex idiom. GraphScript SELECT-FOREACH
--       grammar does NOT accept column aliases (`AS <name>`) on
--       projection expressions; output column names come from the
--       OUT parameter's TABLE definition positionally (documented in
--       sibling KG_SHORTEST_PATH_GRAPH.hdbprocedure header, lines
--       100-108). The stub commit's rationale enumerates the exact
--       parse error from the first-attempt body.
--
-- CALL CONTRACT
--   OUT o_members    Table of (community_id, vertex_key, vertex_type,
--                    slug) rows — one per vertex in KG_PG_WORKSPACE,
--                    partitioned into Louvain communities. Columns
--                    are POSITIONAL — the caller's DO-block wrapper
--                    (srv/jobs/kg-communities-job.js) reads them by
--                    the uppercased names declared here.
--
-- NO `SQL SECURITY DEFINER`
--   LANGUAGE GRAPH rejects the clause. The workspace-level ACL pins
--   execution identity to the HDI object owner, so the DEFINER-owner
--   discipline holds implicitly. Same design as KG_SHORTEST_PATH_GRAPH.
--
-- SINGLE-ARG `Graph()`
--   HDI enforces schema-local PROCEDURE references — the two-arg form
--   `Graph("SCHEMA", "WORKSPACE")` fails with error 8250002
--   ("the reference has to be schema-local"). Sibling procedure's
--   header comment documents this at length.
--
-- Spec:  docs/superpowers/specs/2026-07-04-917-kg-community-detection-design.md
-- Issue: #917
-- ============================================================

PROCEDURE KG_LOUVAIN_GRAPH (
  OUT o_members TABLE (
    community_id BIGINT,
    vertex_key   NVARCHAR(280),
    vertex_type  NVARCHAR(16),
    slug         NVARCHAR(255)
  )
)
LANGUAGE GRAPH READS SQL DATA AS
BEGIN
  GRAPH g = Graph("KG_PG_WORKSPACE");

  -- Communities_Louvain returns SEQUENCE<MULTISET<VERTEX>> — an ordered
  -- collection of vertex groupings, one per detected community. The
  -- single-arg call form (no i_runs) accepts the primitive's default
  -- iteration count, which matches what we want for a nightly batch.
  SEQUENCE<MULTISET<VERTEX>> communities = Communities_Louvain(:g);

  -- TO_ORDINALITY_MAP flattens the sequence into a MAP<VERTEX, BIGINT>
  -- keyed by vertex, valued by the vertex's 1-based ordinal in the
  -- sequence (i.e. its community id). The SELECT-FOREACH below emits
  -- one row per vertex in the workspace, projecting the map lookup
  -- as the community_id column.
  MAP<VERTEX, BIGINT> m_vertexCommunity = TO_ORDINALITY_MAP(:communities);

  -- Positional projection — column names come from the OUT TABLE
  -- declaration above. NO `AS <alias>` clauses (GraphScript parse
  -- rejects them with "unexpected AS, expecting FOREACH or ,").
  -- Vertex properties are the columns of KG_PG_VERTICES_V — VERTEX_KEY,
  -- VERTEX_TYPE, SLUG (see db/src/views/KG_PG_VERTICES_V.hdbview).
  o_members = SELECT :m_vertexCommunity[:v],
                     :v."VERTEX_KEY",
                     :v."VERTEX_TYPE",
                     :v."SLUG"
              FOREACH v IN Vertices(:g);
END;
