-- KG_PATH_V2.hdbprocedure
-- ============================================================
-- WHY DEFINER
--   Consistent with the sibling KG_QUERY / KG_ADMIN_RUNSPARQL / KG_GRAPH_*
--   procedures: HANA Cloud property-graph algorithms (SHORTEST_PATH_*) run
--   over a HANA graph workspace whose access identity is the workspace
--   owner.  Declaring SQL SECURITY DEFINER pins the procedure body to the
--   HDI container's object-owner (#OO) — the same stable identity that
--   owns KG_PG_WORKSPACE — so every binding (tutorials-srv, cds bind
--   probes, future callers) observes the same graph access rights.
--
--   Memory: hana_sparql_per_graph_acl_creator_owns (same rationale
--     generalized to graph workspaces).
--   Spec:   docs/superpowers/specs/2026-07-02-913-kg-property-graph-spike-design.md
--   Issue:  #913
--
-- ERROR CODES (user-defined range 10000–19999)
--   10006  KG_INVALID_TUTORIAL_IRI  – from_iri or to_iri does not match the
--                                     tutorial IRI pattern
--   10010  KG_MAX_HOPS_OUT_OF_RANGE – max_hops not in [1, 20]
--
-- WHY THIS IS TWO PROCEDURES (updated 2026-07-02)
--   HANA does not allow inline `LANGUAGE GRAPH` blocks inside a
--   `LANGUAGE SQLSCRIPT` procedure body. GraphScript is a distinct
--   language declared at the procedure boundary. KG_PATH_V2 (this file,
--   SQLScript) handles input validation + result shaping; the sibling
--   KG_SHORTEST_PATH_GRAPH.hdbprocedure (GraphScript) computes the
--   actual shortest path. KG_PATH_V2 CALLs KG_SHORTEST_PATH_GRAPH.
--
-- QA NOTE
--   db-qa/src/procedures/KG_PATH_V2.hdbprocedure contains a stub with the
--   same signature but a SIGNAL KG_NOT_AVAILABLE_ON_QA body (see spec
--   §"QA channel"). The property-graph workspace, vertex/edge views,
--   AND KG_SHORTEST_PATH_GRAPH are NOT deployed to db-qa.
-- ============================================================

PROCEDURE KG_PATH_V2 (
  IN  from_iri  NVARCHAR(500),
  IN  to_iri    NVARCHAR(500),
  IN  max_hops  INTEGER,
  OUT paths     TABLE (
    path_rank   INTEGER,
    hop_count   INTEGER,
    vertex_seq  NVARCHAR(500),
    seq_index   INTEGER
  )
)
LANGUAGE SQLSCRIPT
SQL SECURITY DEFINER
AS
BEGIN
  DECLARE KG_INVALID_TUTORIAL_IRI CONDITION FOR SQL_ERROR_CODE 10006;
  DECLARE KG_MAX_HOPS_OUT_OF_RANGE CONDITION FOR SQL_ERROR_CODE 10010;

  DECLARE from_key NVARCHAR(400);
  DECLARE to_key   NVARCHAR(400);
  DECLARE effective_max_hops INTEGER;
  DECLARE hop_count_calculated INTEGER;
  -- Table variable for the GraphScript sibling's OUT param. SQLScript
  -- requires all DECLAREs at the top of the BEGIN block — HANA rejects
  -- mid-body DECLAREs with "syntax error near DECLARE".
  DECLARE graph_verts TABLE (vertex_key NVARCHAR(400), seq_idx BIGINT);

  IF :from_iri IS NULL OR NOT (:from_iri LIKE_REGEXPR
       '^https://developers\.sap\.com/kg/tutorial/[a-z0-9-]{1,80}$') OR
     :to_iri IS NULL OR NOT (:to_iri LIKE_REGEXPR
       '^https://developers\.sap\.com/kg/tutorial/[a-z0-9-]{1,80}$') THEN
    SIGNAL KG_INVALID_TUTORIAL_IRI;
  END IF;

  effective_max_hops := COALESCE(:max_hops, 8);
  IF effective_max_hops < 1 OR effective_max_hops > 20 THEN
    SIGNAL KG_MAX_HOPS_OUT_OF_RANGE;
  END IF;

  from_key := 'tutorial:' ||
    SUBSTR(:from_iri, LENGTH('https://developers.sap.com/kg/tutorial/') + 1);
  to_key   := 'tutorial:' ||
    SUBSTR(:to_iri,   LENGTH('https://developers.sap.com/kg/tutorial/') + 1);

  -- Delegate to the GraphScript sibling for the SHORTEST_PATH call.
  -- Returns the vertex sequence as (VERTEX_KEY, SEQ_IDX) rows. Empty
  -- when no path exists — no SIGNAL, empty is a valid answer per spec.
  CALL KG_SHORTEST_PATH_GRAPH(:from_key, :to_key, :graph_verts);

  -- Compute hop count: edges in the path = vertices - 1. For the
  -- PREREQ semantics (tutorial→concept*→tutorial), the two tutorial
  -- endpoints are "teaches" edges, so PREREQ-relevant hop_count is
  -- (total vertices - 1) - 2 = (total vertices - 3). But the JS
  -- wrapper's mapper only uses `hop_count` for logging today; sticking
  -- with the total-edge count (vertices - 1) is simpler and matches
  -- what a caller who wants "how far apart are these tutorials"
  -- intuitively expects. If we later add a `prereqDepth` field, we
  -- compute it there.
  SELECT COUNT(*) - 1 INTO hop_count_calculated FROM :graph_verts;
  IF hop_count_calculated < 0 THEN hop_count_calculated := 0; END IF;

  -- Enforce max_hops post-hoc: if the shortest path exceeds the cap,
  -- return empty. Cheaper than trying to encode a hop bound into the
  -- GraphScript algorithm parameters.
  IF hop_count_calculated > :effective_max_hops THEN
    paths = SELECT
              CAST(NULL AS INTEGER)       AS path_rank,
              CAST(NULL AS INTEGER)       AS hop_count,
              CAST(NULL AS NVARCHAR(500)) AS vertex_seq,
              CAST(NULL AS INTEGER)       AS seq_index
            FROM DUMMY WHERE 1 = 0;
    RETURN;
  END IF;

  -- Shape to the wire contract. Always path_rank=1 (SHORTEST_PATH
  -- returns a single path, or nothing). seq_index is 0-based per
  -- the CDS return-type documentation in the plan's Step 3.2.
  paths = SELECT
            1                                        AS path_rank,
            :hop_count_calculated                    AS hop_count,
            CAST(vertex_key AS NVARCHAR(500))        AS vertex_seq,
            CAST(seq_idx - 1 AS INTEGER)             AS seq_index
          FROM :graph_verts
          ORDER BY seq_idx;
END;
